#!/usr/bin/env bash
set -euo pipefail
# Ignore the caller's Git and tool settings: a hook's GIT_DIR would point every git call at the real repo.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE REPO PR VERSION CONFIRM DEFAULT_BASE_BRANCH RELEASE_WORKFLOW GITHUB_REPOSITORY
# Under make test, the make variables would turn the tests' own make runs into sub-makes that print "Entering directory".
unset MAKELEVEL MAKEFLAGS MFLAGS
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
# The status tag, coloured only on a terminal and never with NO_COLOR set.
if [[ -t 1 && -z ${NO_COLOR-} ]]; then
	ok_tag=$'\033[90m[\033[38;5;154m  OK  \033[90m]\033[0m'
else
	ok_tag='[  OK  ]'
fi

exec </dev/null # prompts see a closed stdin unless a step feeds an answer
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
test_root=$(mktemp -d /tmp/gh-release-flow.XXXXXX)
trap 'rm -rf -- "$test_root"' EXIT
repo=$test_root/repo
origin=$test_root/origin.git
bin=$test_root/bin
state=$test_root/gh-state
body=$test_root/pr-body
merge_log=$test_root/gh-merge
release_log=$test_root/gh-release-edit
api_log=$test_root/gh-api
rulesets_file=$test_root/gh-rulesets
mkdir -p "$repo" "$bin"

git -C "$repo" init -q
git -C "$repo" config user.name 'John Smith'
git -C "$repo" config user.email tester@example.com
git -C "$repo" commit --allow-empty -qm 'chore: base'
git -C "$repo" branch -M main
git -C "$repo" tag v0.1.0
unrelated=$(git -C "$repo" commit-tree "$(git -C "$repo" write-tree)" -m 'unrelated release')
git -C "$repo" tag v9.0.0 "$unrelated"
git init --bare -q "$origin"
git -C "$repo" remote add origin "$origin"
git -C "$repo" push -qu origin main
git -C "$repo" checkout -qb dev/v0.2.0
git -C "$repo" commit --allow-empty -qm 'fix: preserve | pipe and \backslash'
printf 'John Smith <tester@example.com>\n' >"$repo/.mailmap"
git -C "$repo" add .mailmap
git -C "$repo" -c user.name='J. Smith' commit -qm 'chore: map author names'
git -C "$repo" commit --allow-empty -qm 'chore: bot work' --author='github-actions[bot] <bot@example.com>'

cat >"$bin/gh" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
args=" $* "
# gh api: the owner's .github repository is the Git repository GH_DEFAULTS (none when unset), the
# repository's rulesets are "target<TAB>name" lines in GH_RULESETS, and every call is logged to GH_API_LOG.
if [[ $1 == api ]]; then
	endpoint=$2 method=GET input='' jq='' raw=0
	shift 2
	while (($#)); do
		case $1 in
		--method) method=$2 && shift ;;
		--input) input=$2 && shift ;;
		--jq) jq=$2 && shift ;;
		-H)
			[[ $2 != 'Accept: application/vnd.github.raw+json' ]] || raw=1
			shift
			;;
		--paginate | --silent) ;;
		*)
			echo "fake gh: unexpected api argument $1" >&2
			exit 1
			;;
		esac
		shift
	done
	echo "$method $endpoint${input:+ $(tr -d '\n' <"$input")}" >>"$GH_API_LOG"
	if [[ -n ${GH_FAIL:-} && $endpoint == *"$GH_FAIL" ]]; then
		echo 'gh: Validation Failed (HTTP 422)' >&2
		exit 1
	fi
	# Sets name and target from a ruleset's JSON, which init reads with --jq; the test rulesets are simple.
	ruleset_fields() {
		name='' target=''
		[[ ! $1 =~ \"name\":\ *\"([^\"]*)\" ]] || name=${BASH_REMATCH[1]}
		[[ ! $1 =~ \"target\":\ *\"([^\"]*)\" ]] || target=${BASH_REMATCH[1]}
	}
	case "$method $endpoint" in
	'GET user') echo owner ;;
	'GET repos/owner/.github/git/trees/HEAD?recursive=1')
		if [[ -z ${GH_DEFAULTS:-} ]]; then
			echo '{"message":"Not Found","status":"404"}'
			echo 'gh: Not Found (HTTP 404)' >&2
			exit 1
		fi
		git -C "$GH_DEFAULTS" ls-tree -r HEAD | while read -r mode type sha path; do
			if [[ $type == blob && $path == defaults/* ]]; then
				printf '%s\t%s\t%s\n' "$mode" "$sha" "$path"
			fi
		done
		;;
	'GET repos/owner/.github/git/blobs/'*)
		if ((raw)); then
			git -C "$GH_DEFAULTS" cat-file blob "${endpoint##*/}"
		elif [[ $jq == '.content | @base64d | fromjson | [.name, .target] | @tsv' ]]; then
			ruleset_fields "$(git -C "$GH_DEFAULTS" cat-file blob "${endpoint##*/}")"
			printf '%s\t%s\n' "$name" "$target"
		else
			echo "fake gh: unexpected blob query $jq" >&2
			exit 1
		fi
		;;
	'GET repos/owner/project/rulesets') cat -- "$GH_RULESETS" 2>/dev/null || true ;;
	'POST repos/owner/project/rulesets')
		ruleset_fields "$(<"$input")"
		printf '%s\t%s\n' "$target" "$name" >>"$GH_RULESETS"
		;;
	'PATCH repos/owner/project'* | 'PUT repos/owner/project/'*) ;;
	*)
		echo "unexpected gh invocation: api $method $endpoint" >&2
		exit 1
		;;
	esac
	exit 0
fi
case "$1 $2" in
'repo view') echo 'github.com/owner/project' ;;
'repo create')
	if [[ $* != 'repo create owner/project --public --source . --remote origin' ]]; then
		echo "fake gh: unexpected $*" >&2
		exit 1
	fi
	echo "$*" >>"$GH_API_LOG"
	git init --bare -q "$GH_NEW_ORIGIN"
	git remote add origin "$GH_NEW_ORIGIN"
	;;
'pr list')
	if [[ ${GH_REPO:-} != github.com/owner/project ]]; then
		echo "fake gh: pr list targets '${GH_REPO:-}', not the push repository" >&2
		exit 1
	fi
	if [[ $args != *'number,headRepositoryOwner'* || $args != *'headRepositoryOwner.login'* ]]; then
		echo 'fake gh: pr list was called without the owner filter' >&2
		exit 1
	fi
	if [[ $args == *' --state merged '* && ${GH_MERGED:-0} == 1 ]]; then
		echo 17
	elif [[ $args == *' --state open '* && ${GH_MERGED:-0} != 1 && -f $GH_STATE ]]; then
		echo 17
	fi
	;;
'pr create' | 'pr edit')
	while (($#)); do
		[[ $1 != --body-file ]] || {
			shift
			cp "$1" "$GH_BODY"
			break
		}
		shift
	done
	: >"$GH_STATE"
	;;
'pr checks')
	if [[ ${GH_CHECKS:-} == pass ]]; then
		echo 'All checks were successful'
	else
		echo 'no checks reported on the branch' >&2
		exit 1
	fi
	;;
'pr view')
	if [[ $args == *' --json url '* ]]; then
		echo 'https://github.com/owner/project/pull/17'
	elif [[ $args == *'headRefOid'* ]]; then
		printf 'main\t%s\t%s\towner\t%s\n' "$(git branch --show-current)" \
			"${GH_PR_OID:-$(git rev-parse HEAD)}" "${GH_CROSS:-false}"
	elif [[ $args == *' --json state '* ]]; then
		echo MERGED
	elif [[ $args == *' --json mergedAt '* ]]; then
		echo '2026-01-02T00:00:00Z'
	fi
	;;
'pr merge')
	echo "$*" >>"$GH_MERGE_LOG"
	git push -q origin HEAD:refs/heads/main # what GitHub does on merge
	;;
'run list')
	if [[ $args == *' --help '* ]]; then
		echo '  -c, --commit SHA'
	elif [[ $args == *' --created >=2026-01-02T00:00:00Z '* ]]; then
		printf '99\tcompleted\tsuccess\n'
	else
		printf '98\tcompleted\tfailure\n'
	fi
	;;
'run view') ;;
'extension upgrade' | 'release-flow setup-make') echo "$*" ;;
'release view') printf 'https://github.com/owner/project/releases/tag/%s\t%s\n' "$3" "${GH_RELEASE_NAME-$3}" ;;
'release edit') echo "$*" >>"$GH_RELEASE_LOG" ;;
*)
	echo "unexpected gh invocation: $*" >&2
	exit 1
	;;
esac
EOF
cat >"$bin/sleep" <<'EOF'
#!/usr/bin/env bash
exit 0
EOF
chmod +x "$bin/gh" "$bin/sleep"

flow() {
	(cd "$repo" && PATH="$bin:$PATH" GH_STATE=$state GH_BODY=$body GH_MERGE_LOG=$merge_log \
		GH_RELEASE_LOG=$release_log "$script_dir/gh-release-flow" "$@")
}
fails_with() {
	local want=$1 out
	shift
	if out=$("$@" 2>&1); then
		echo "expected a failure from: $*" >&2
		exit 1
	fi
	[[ $out == *"$want"* ]] || {
		printf 'expected "%s" from %s, got:\n%s\n' "$want" "$*" "$out" >&2
		exit 1
	}
}
branch_gone() {
	if git -C "$repo" show-ref --verify --quiet "refs/heads/$1"; then
		echo "local $1 branch still exists" >&2
		exit 1
	fi
	if git -C "$repo" ls-remote --exit-code --heads origin "refs/heads/$1" >/dev/null; then
		echo "remote $1 branch still exists" >&2
		exit 1
	fi
}

flow open-pr >/dev/null
[[ -s $body ]]
grep -Fq '###  Bug Fixes' "$body"
grep -Fq 'fix: preserve | pipe and \backslash' "$body"
grep -Fq 'by John Smith' "$body"
grep -Fq '* John Smith' "$body"
grep -Fq 'https://github.com/owner/project/commit/' "$body"
if grep -Fq 'J. Smith' "$body" || grep -Fq 'github-actions[bot]' "$body"; then
	echo 'a mapped or filtered author was credited' >&2
	exit 1
fi
if grep -Fq '@John Smith' "$body"; then
	echo 'author name was converted to a GitHub mention' >&2
	exit 1
fi
grep -Fq '/compare/v0.1.0...v0.2.0' "$body"
if grep -Fq '/compare/v9.0.0...v0.2.0' "$body"; then
	echo 'unreachable release tag was selected' >&2
	exit 1
fi
git -C "$repo" ls-remote --exit-code --heads origin refs/heads/dev/v0.2.0 >/dev/null

# Pushing to an existing PR refreshes its body, with each commit in its group.
git -C "$repo" commit --allow-empty -qm 'feat(api): add widget'
git -C "$repo" commit --allow-empty -qm 'feat!: drop old option'
git -C "$repo" commit --allow-empty -qm 'docs: explain widget'
git -C "$repo" commit --allow-empty -qm 'Tidy things'
: >"$body"
flow open-pr >/dev/null
body_text=$(<"$body")
[[ $body_text == *$'###  Features\n\n* feat(api): add widget'* ]]
[[ $body_text == *$'###  Documentation\n\n* docs: explain widget'* ]]
[[ $body_text == *$'by John Smith\n* feat!: drop old option'* ]]
[[ $body_text == *$'###  Other Changes\n\n* Tidy things'* ]]
git -C "$repo" commit --allow-empty -qm 'perf: pushed with plain git'
git -C "$repo" push -q
: >"$body"
flow open-pr >/dev/null
grep -Fq 'perf: pushed with plain git' "$body"

# open-pr refuses a branch that is behind or has diverged from the remote.
git -C "$repo" commit --allow-empty -qm 'chore: remote only'
git -C "$repo" push -q origin HEAD:refs/heads/dev/v0.2.0
git -C "$repo" reset -q --hard HEAD~1
fails_with 'commit(s) behind' flow open-pr
git -C "$repo" commit --allow-empty -qm 'chore: local only'
fails_with 'has diverged' flow open-pr
git -C "$repo" reset -q --hard origin/dev/v0.2.0

# merge refuses unsynchronized, forked, unchecked and unconfirmed PRs.
git -C "$repo" commit --allow-empty -qm 'chore: unpushed'
GH_CHECKS=pass fails_with 'Local HEAD is not synchronized' flow merge
git -C "$repo" reset -q --hard origin/dev/v0.2.0
GH_CHECKS=pass GH_PR_OID=0000000000000000000000000000000000000000 \
	fails_with 'is not synchronized with local' flow merge
GH_CHECKS=pass GH_CROSS=true fails_with 'comes from a fork' flow merge
fails_with 'No CI checks are reported' flow merge
GH_CHECKS=pass fails_with 'Merge aborted.' flow merge
if [[ -e $merge_log ]]; then
	echo 'a refused merge still called gh pr merge' >&2
	exit 1
fi

# merge pins the exact head commit, then cleans up and names a release published without a title.
release_head=$(git -C "$repo" rev-parse HEAD)
out=$(GH_CHECKS=pass CONFIRM=0 GH_RELEASE_NAME='' flow merge)
grep -Fq -- "--match-head-commit $release_head" "$merge_log"
[[ $(git -C "$repo" branch --show-current) == main ]]
branch_gone dev/v0.2.0
[[ $(<"$release_log") == 'release edit v0.2.0 --title v0.2.0' ]]
[[ $out == *'release.yml published v0.2.0 without a title'* ]]

# start-dev creates and publishes a release branch, and later reuses the remote copy.
flow start-dev v0.3.0 >/dev/null
[[ $(git -C "$repo" branch --show-current) == dev/v0.3.0 ]]
git -C "$repo" commit --allow-empty -qm 'feat: three'
git -C "$repo" push -q
release_head=$(git -C "$repo" rev-parse HEAD)
git -C "$repo" checkout -q main
git -C "$repo" branch -q -D dev/v0.3.0
flow start-dev v0.3.0 >/dev/null
[[ $(git -C "$repo" rev-parse HEAD) == "$release_head" ]]
[[ $(git -C "$repo" rev-parse --abbrev-ref '@{u}') == origin/dev/v0.3.0 ]]
git -C "$repo" push -q origin v0.1.0
fails_with 'Tag v0.1.0 already exists' flow start-dev v0.1.0
git clone -q -b main "$origin" "$test_root/clone"
git -C "$test_root/clone" branch dev
(cd "$test_root/clone" && fails_with "A branch named 'dev' exists" "$script_dir/gh-release-flow" start-dev v0.4.0)

# A resumed merge must not delete a commit pushed after the merge, even when GitHub already deleted the branch.
git -C "$repo" checkout -q main
git -C "$repo" merge -q --no-ff dev/v0.3.0 -m 'Merge release'
git -C "$repo" push -q origin main
git -C "$repo" checkout -q dev/v0.3.0
git -C "$repo" commit --allow-empty -qm 'fix: after merge'
git -C "$repo" push -q
git --git-dir="$origin" update-ref -d refs/heads/dev/v0.3.0
GH_MERGED=1 GH_PR_OID=$release_head fails_with 'Unable to delete local branch' flow merge
git -C "$repo" show-ref --verify --quiet refs/heads/dev/v0.3.0
git -C "$repo" checkout -q dev/v0.3.0
git -C "$repo" reset -q --hard "$release_head"
rm -f -- "$release_log"
GH_MERGED=1 GH_PR_OID=$release_head flow merge >/dev/null
[[ $(git -C "$repo" branch --show-current) == main ]]
branch_gone dev/v0.3.0
if [[ -e $release_log ]]; then
	echo 'merge renamed a release that already had a title' >&2
	exit 1
fi

# start-dev offers to move uncommitted changes from main, and only from main.
printf 'one\n' >"$repo/notes.txt"
git -C "$repo" add notes.txt
git -C "$repo" commit -qm 'docs: add notes'
git -C "$repo" push -q origin main
git -C "$repo" checkout -q -b scratch
printf 'two\n' >"$repo/notes.txt"
fails_with 'Working tree not clean' flow start-dev v0.4.0 <<<y
git -C "$repo" checkout -q main
fails_with 'Working tree not clean' flow start-dev v0.4.0
[[ $(git -C "$repo" branch --show-current) == main && $(<"$repo/notes.txt") == two ]]
if git -C "$repo" show-ref --quiet refs/heads/dev/v0.4.0 refs/remotes/origin/dev/v0.4.0; then
	echo 'a declined move still created the release branch' >&2
	exit 1
fi
flow start-dev v0.4.0 <<<y >/dev/null
[[ $(git -C "$repo" branch --show-current) == dev/v0.4.0 && $(<"$repo/notes.txt") == two ]]
git -C "$repo" ls-remote --exit-code --heads origin refs/heads/dev/v0.4.0 >/dev/null
# If main moved on the same file, Git refuses and the changes stay untouched on main.
git -C "$repo" checkout -q main
git -C "$test_root/clone" pull -q
printf 'remote\n' >"$test_root/clone/notes.txt"
git -C "$test_root/clone" -c user.name=Other -c user.email=other@example.com commit -qam 'docs: edit notes'
git -C "$test_root/clone" push -q origin main
fails_with 'would be overwritten' flow start-dev v0.5.0 <<<y
[[ $(git -C "$repo" branch --show-current) == main && $(<"$repo/notes.txt") == two ]]
git -C "$repo" checkout -q -- notes.txt
git -C "$repo" pull -q --ff-only

# The version prompt explains a closed stdin instead of exiting silently.
fails_with 'VERSION must look like' flow start-dev

# setup-make installs user-wide Make targets and a make function, and says when a new terminal is needed.
home=$test_root/home
mkdir -p "$home" "$test_root/empty" "$test_root/project"
: >"$home/.zshrc"
setup_make() {
	HOME=$home PATH="$bin:$PATH" "$script_dir/gh-release-flow" setup-make
}
# Without Make targets from setup-make, upgrade only upgrades the extension.
[[ $(HOME=$home PATH="$bin:$PATH" "$script_dir/gh-release-flow" upgrade) == 'extension upgrade release-flow' ]]
[[ $(setup_make) == *'Open a new terminal'* && $(setup_make) == 'OK: Make targets are up to date.' ]]
for rc in "$home/.bashrc" "$home/.zshrc"; do
	[[ $(grep -c 'release-flow\.mk' "$rc") == 1 && $(grep -c 'release-flow\.sh' "$rc") == 1 ]]
done
targets_file=$home/.config/make/release-flow.mk
[[ $(MAKEFILES=$targets_file make -C "$test_root/empty" --no-print-directory -n init) == 'gh release-flow "init"' ]]
[[ $(MAKEFILES=$targets_file make -C "$test_root/empty" --no-print-directory -n start-dev) == 'gh release-flow "start-dev"' ]]
[[ $(MAKEFILES=$targets_file make -C "$test_root/empty" --no-print-directory -n rf-upgrade) == 'gh release-flow "upgrade"' ]]
# Project Makefiles that read MAKEFILE_LIST do not see the user-wide file.
# shellcheck disable=SC2016
printf 'help:\n\t@echo project help\nwhere:\n\t@echo $(firstword $(MAKEFILE_LIST))\nfail:\n\t@exit 1\n' \
	>"$test_root/project/Makefile"
make_function() {
	(cd "$test_root/$1" && HOME=$home MAKEFILES=$targets_file \
		bash -c '. "$HOME/.config/make/release-flow.sh" && make "$@"' make "${@:2}")
}
targets_line=' release-flow:  init  start-dev  open-pr  merge-release  rf-version  rf-upgrade'
# make help ends with a blank line and the targets; plain make without a Makefile prints only them; other runs are untouched.
[[ $(make_function empty) == "$targets_line" && $(make_function empty help) == "$targets_line" ]]
[[ $(make_function project help) == "project help"$'\n\n'"$targets_line" ]]
[[ $(make_function project where) == Makefile ]]
# Plain make behaves like make help when the default goal is help, set explicitly or by being first.
mkdir -p "$test_root/helpdefault" "$test_root/helpfirst" "$test_root/otherdefault" "$test_root/helpfails"
printf '.DEFAULT_GOAL := help\nbuild:\n\t@echo building\nhelp:\n\t@echo project help\n' >"$test_root/helpdefault/Makefile"
cp "$test_root/project/Makefile" "$test_root/helpfirst/Makefile"
printf 'build:\n\t@echo building\nhelp:\n\t@echo project help\n' >"$test_root/otherdefault/Makefile"
printf '.DEFAULT_GOAL := help\nhelp:\n\t@echo project help\n\t@exit 1\n' >"$test_root/helpfails/Makefile"
[[ $(make_function helpdefault) == "project help"$'\n\n'"$targets_line" ]]
[[ $(make_function helpfirst) == "project help"$'\n\n'"$targets_line" ]]
# Any other default goal, or any argument besides help, is untouched.
[[ $(make_function otherdefault) == building ]]
[[ $(make_function helpdefault build) == building ]]
status=0
make_function helpfails >/dev/null 2>&1 || status=$?
[[ $status == 2 ]]
status=0
make_function project fail >/dev/null 2>&1 || status=$?
[[ $status == 2 ]]
# A changed make function asks for a new terminal again.
echo '# old' >"$home/.config/make/release-flow.sh"
[[ $(setup_make) == *'Open a new terminal'* ]]
# upgrade refreshes the Make targets that setup-make wrote.
[[ $(HOME=$home PATH="$bin:$PATH" "$script_dir/gh-release-flow" upgrade) == 'extension upgrade release-flow'$'\n''release-flow setup-make' ]]
# A file setup-make did not write is replaced only after a yes; upgrade leaves it alone.
printf 'custom:\n' >"$targets_file"
fails_with 'Kept' setup_make
[[ $(<"$targets_file") == custom: ]]
[[ $(HOME=$home PATH="$bin:$PATH" "$script_dir/gh-release-flow" upgrade) == 'extension upgrade release-flow' ]]
setup_make <<<y >/dev/null
grep -Fq 'rf-version rf-upgrade:' "$targets_file"
fails_with 'path with spaces' env HOME="$test_root/my home" "$script_dir/gh-release-flow" setup-make
[[ ! -e "$test_root/my home" ]]
for command in upgrade setup-make; do
	if HOME=$home PATH="$bin:$PATH" "$script_dir/gh-release-flow" "$command" extra >/dev/null 2>&1; then
		echo "$command accepted an argument" >&2
		exit 1
	fi
done

# Without defaults in the owner's .github repository, init says so and, as before, writes a known-good release
# workflow at the repository root, from any subfolder.
init_repo=$test_root/init-repo
mkdir -p "$init_repo/sub" "$test_root/outside"
git -C "$init_repo" init -q
init() {
	(cd "$init_repo/sub" && PATH="$bin:$PATH" GH_API_LOG=$api_log "$script_dir/gh-release-flow" "$@")
}
no_defaults='==> Found no defaults/ folder in owner/.github, so init writes the release workflow only.'
workflow=$init_repo/.github/workflows/release.yml
[[ $(init init) == "$no_defaults"$'\nOK: Wrote .github/workflows/release.yml for releases merged into main.\n'* ]]
grep -Fq "branches: ['main']" "$workflow"
grep -Fq 'startsWith(github.event.pull_request.head.ref, '\''dev/v'\'')' "$workflow"
# shellcheck disable=SC2016
grep -Fq -- '--title "$tag"' "$workflow"
[[ $(<"$workflow") != *__BASE_BRANCH__* ]]
[[ $(tail -c 1 "$workflow" | od -An -c | tr -d ' ') == '\n' ]]
# Running it again changes nothing; a different file is kept unless --force replaces it.
[[ $(init init) == "$no_defaults"$'\nOK: .github/workflows/release.yml is up to date.' ]]
echo '# mine' >>"$workflow"
fails_with 'already exists and differs' init init
[[ $(tail -n 1 "$workflow") == '# mine' ]]
init init --force >/dev/null
[[ $(<"$workflow") != *'# mine'* ]]
# The base branch and the workflow file name follow the configuration.
(cd "$init_repo" && PATH="$bin:$PATH" GH_API_LOG=$api_log DEFAULT_BASE_BRANCH=trunk RELEASE_WORKFLOW=publish.yaml \
	"$script_dir/gh-release-flow" init >/dev/null)
grep -Fq "branches: ['trunk']" "$init_repo/.github/workflows/publish.yaml"
# Bad configuration and arguments fail before any gh call: the fake gh has no log to write to here.
fails_with 'file name ending in .yml' env PATH="$bin:$PATH" RELEASE_WORKFLOW=../release.yml "$script_dir/gh-release-flow" init
fails_with 'cannot write DEFAULT_BASE_BRANCH' env PATH="$bin:$PATH" DEFAULT_BASE_BRANCH="a'b" "$script_dir/gh-release-flow" init
fails_with 'init accepts only --force' init init extra
# Outside a Git working tree it still stops after the lookup, without git init or a GitHub repository.
init_outside() {
	(cd "$test_root/outside" && PATH="$bin:$PATH" GH_API_LOG=$api_log "$script_dir/gh-release-flow" init)
}
: >"$api_log"
fails_with 'Not inside a Git working tree' init_outside
[[ ! -e $test_root/outside/.git && $(<"$api_log") == $'GET user\nGET repos/owner/.github/git/trees/HEAD?recursive=1' ]]
# The generated workflow passes actionlint when it is installed.
if command -v actionlint >/dev/null; then (cd "$init_repo" && actionlint); fi

# With defaults in the owner's .github repository, init sets up the repository from them.
dotgithub=$test_root/dotgithub
mkdir -p "$dotgithub/defaults/files/.github/workflows" "$dotgithub/defaults/settings" "$dotgithub/defaults/rulesets"
printf 'MIT License\n\nCopyright (c) {{year}} John Smith\n' >"$dotgithub/defaults/files/LICENSE"
printf 'Report at https://github.com/{{owner}}/{{repo}}/security/advisories/new' >"$dotgithub/defaults/files/SECURITY.md"
printf '* @{{owner}}\n' >"$dotgithub/defaults/files/.github/CODEOWNERS"
printf 'name: not the release workflow\n' >"$dotgithub/defaults/files/.github/workflows/release.yml"
printf '{"allow_squash_merge": false}\n' >"$dotgithub/defaults/settings/repo.json"
printf '{"default_workflow_permissions": "read"}\n' >"$dotgithub/defaults/settings/actions-workflow.json"
printf '{"state": "configured"}\n' >"$dotgithub/defaults/settings/code-scanning-default-setup.json"
for setting in vulnerability-alerts automated-security-fixes private-vulnerability-reporting immutable-releases; do
	: >"$dotgithub/defaults/settings/$setting"
done
printf '{}\n' >"$dotgithub/defaults/settings/future-setting.json"
printf '{"name": "main", "target": "branch", "enforcement": "active"}\n' >"$dotgithub/defaults/rulesets/main.json"
printf '{"name": "release tags", "target": "tag", "enforcement": "active"}\n' >"$dotgithub/defaults/rulesets/release-tags.json"
printf 'The owner defaults.\n' >"$dotgithub/README.md"
git -C "$dotgithub" init -q
git -C "$dotgithub" add -A
git -C "$dotgithub" -c user.name=t -c user.email=t@example.com commit -qm defaults
year=$(date +%Y)
# Every settings call, in the order init makes them.
settings_sent=$(printf '%s\n' \
	'PATCH repos/owner/project {"allow_squash_merge": false}' \
	'PUT repos/owner/project/actions/permissions/workflow {"default_workflow_permissions": "read"}' \
	'PUT repos/owner/project/vulnerability-alerts' \
	'PUT repos/owner/project/automated-security-fixes' \
	'PUT repos/owner/project/private-vulnerability-reporting' \
	'PUT repos/owner/project/immutable-releases' \
	'PATCH repos/owner/project/code-scanning/default-setup {"state": "configured"}')
defaults_init() {
	local dir=$1
	shift
	(cd "$dir" && PATH="$bin:$PATH" GH_DEFAULTS=$dotgithub GH_API_LOG=$api_log GH_RULESETS=$rulesets_file \
		GH_NEW_ORIGIN=$dir.git GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@example.com \
		GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@example.com "$script_dir/gh-release-flow" init "$@")
}
# On a new folder with every answer yes: git init, the repository, the files in one root commit pushed to a
# main that tracks origin, all the settings, and both rulesets.
fresh=$test_root/fresh/project
mkdir -p "$fresh"
: >"$api_log"
out=$(defaults_init "$fresh" <<<$'y\ny\ny\ny')
[[ $(git -C "$fresh" log --format=%s main) == 'chore: add repository defaults' ]]
[[ $(git --git-dir="$fresh.git" show --name-only --format= main) == $'.github/CODEOWNERS\n.github/workflows/release.yml\nLICENSE\nSECURITY.md' ]]
[[ $(git -C "$fresh" rev-parse --abbrev-ref 'main@{u}') == origin/main ]]
[[ $(grep -E '^(PUT|PATCH) ' "$api_log") == "$settings_sent" && $(<"$rulesets_file") == $'branch\tmain\ntag\trelease tags' ]]
[[ $out == *'Git:        done, created a repository on main'* && $out == *'Push:       done'* ]]
: >"$rulesets_file"
# Without origin it runs git init, then asks before creating the GitHub repository; a no stops the run there.
project=$test_root/new/project
mkdir -p "$project"
: >"$api_log"
fails_with 'init needs a GitHub repository' defaults_init "$project" <<<n
[[ $(git -C "$project" symbolic-ref --short HEAD) == main && -z $(git -C "$project" remote) ]]
[[ -z $(git -C "$project" status --porcelain --untracked-files=all) ]]
if grep -q 'repo create' "$api_log"; then
	echo 'a declined init created the repository' >&2
	exit 1
fi
# A yes creates it and writes the files with their placeholders filled, the release workflow from the template.
# With the push declined they stay uncommitted, so CodeQL default setup and the branch ruleset are held back,
# while the tag ruleset is created. Unknown files are reported and skipped.
: >"$api_log"
out=$(defaults_init "$project" <<<$'y\nn\ny\ny')
grep -Fxq 'repo create owner/project --public --source . --remote origin' "$api_log"
[[ $(git -C "$project" remote get-url origin) == "$project.git" ]]
[[ $(<"$project/LICENSE") == *"Copyright (c) $year John Smith" ]]
[[ $(<"$project/SECURITY.md") == 'Report at https://github.com/owner/project/security/advisories/new' ]]
[[ $(tail -c 1 "$project/SECURITY.md") == w && $(<"$project/.github/CODEOWNERS") == '* @owner' ]]
grep -Fq "branches: ['main']" "$project/.github/workflows/release.yml"
[[ $out == *'Skipped defaults/files/.github/workflows/release.yml'* && $out == *'Skipped defaults/settings/future-setting.json'* ]]
if git -C "$project" rev-parse -q --verify HEAD >/dev/null || [[ -n $(git --git-dir="$project.git" for-each-ref) ]]; then
	echo 'a declined push still committed or pushed' >&2
	exit 1
fi
[[ $(grep -E '^(PUT|PATCH) ' "$api_log") == "$(head -n 6 <<<"$settings_sent")" ]]
[[ $(<"$rulesets_file") == $'tag\trelease tags' ]]
[[ $out == *'Push:       declined'* && $out == *'held back CodeQL default setup until main is on GitHub'* ]]
[[ $out == *'Rulesets:   held back main until the files are on main; done, created release tags'* ]]
# Once the files are on main, the next run applies CodeQL default setup and creates the branch ruleset.
git -C "$project" add -A
git -C "$project" -c user.name=t -c user.email=t@example.com commit -qm 'chore: add the defaults'
git -C "$project" push -q -u origin main
: >"$api_log"
out=$(defaults_init "$project" <<<$'y\ny')
[[ $(grep -E '^(PUT|PATCH) ' "$api_log") == "$settings_sent" ]]
[[ $(<"$rulesets_file") == $'tag\trelease tags\nbranch\tmain' ]]
[[ $out == *'Rulesets:   done, created main; already done, kept release tags'* ]]
# A second run on a finished repository asks once, writes no file and creates nothing; it sends the settings again.
head=$(git -C "$project" rev-parse HEAD)
: >"$api_log"
out=$(defaults_init "$project" <<<y)
[[ $(grep -c '\[y/N\]' <<<"$out") == 1 ]]
[[ $(git -C "$project" rev-parse HEAD) == "$head" && -z $(git -C "$project" status --porcelain) ]]
[[ $(grep -Ev '^GET ' "$api_log") == "$settings_sent" ]]
[[ $out == *'Files:      already done'* && $out == *'Push:       already done'* ]]
[[ $out == *'Settings:   done, sent 7 (every run sends them again)'* && $out == *'Rulesets:   already done, kept main, release tags'* ]]
# A failed setting stops the run and says which settings were sent and which were not.
status=0
out=$(GH_FAIL=/automated-security-fixes defaults_init "$project" <<<y 2>&1) || status=$?
[[ $status == 1 && $out == *'Done: repo.json, actions-workflow.json, vulnerability-alerts'* ]]
[[ $out == *'Not done: automated-security-fixes, private-vulnerability-reporting, immutable-releases, code-scanning-default-setup.json'* ]]

# In a repository with origin, init refuses to push while origin has commits that main lacks, and checks that
# before writing anything. It keeps the user's files, lists the unpushed commits the push would publish, and
# commits only the files it wrote.
existing=$test_root/existing
git init -q -b main "$existing"
git -C "$existing" config user.name 'John Smith'
git -C "$existing" config user.email tester@example.com
printf 'my license\n' >"$existing/LICENSE"
git -C "$existing" add LICENSE
git -C "$existing" commit -qm 'chore: add a license'
git init --bare -q "$test_root/existing.git"
git -C "$existing" remote add origin "$test_root/existing.git"
git -C "$existing" push -qu origin main
git clone -q -b main "$test_root/existing.git" "$test_root/existing-other"
git -C "$test_root/existing-other" -c user.name=Other -c user.email=other@example.com commit --allow-empty -qm 'docs: from elsewhere'
git -C "$test_root/existing-other" push -q
git -C "$existing" commit --allow-empty -qm 'feat: user work'
: >"$rulesets_file"
fails_with 'Pull them first' defaults_init "$existing"
[[ ! -e $existing/SECURITY.md ]]
git -C "$existing" pull -q --rebase
printf 'draft\n' >"$existing/notes.txt"
git -C "$existing" add notes.txt
: >"$api_log"
out=$(defaults_init "$existing" <<<$'y\nn\nn')
[[ $out == *'kept     LICENSE (yours differs; --force replaces it)'* && $(<"$existing/LICENSE") == 'my license' ]]
[[ $out == *'feat: user work'*'Commit and push these to owner/project main? [y/N]'* ]]
[[ $(git --git-dir="$test_root/existing.git" log -2 --format=%s main) == $'chore: add repository defaults\nfeat: user work' ]]
[[ $(git --git-dir="$test_root/existing.git" show --name-only --format= main) == $'.github/CODEOWNERS\n.github/workflows/release.yml\nSECURITY.md' ]]
[[ $(git -C "$existing" status --porcelain) == 'A  notes.txt' ]]
[[ $out == *'Settings:   declined'* && $out == *'Rulesets:   declined main, release tags'* ]]
if grep -Eq '^(PUT|PATCH|POST) ' "$api_log"; then
	echo 'declined settings or rulesets were applied' >&2
	exit 1
fi
# --force replaces a file that differs, but once the repository has a branch ruleset, init does not push.
printf 'branch\tmain\n' >"$rulesets_file"
head=$(git -C "$existing" rev-parse HEAD)
out=$(defaults_init "$existing" --force)
[[ $out == *'replace  LICENSE'* && $out == *'has a branch ruleset, so init does not push to main'* ]]
[[ $(<"$existing/LICENSE") == *"Copyright (c) $year John Smith" ]]
[[ $(git -C "$existing" rev-parse HEAD) == "$head" && $(git -C "$existing" status --porcelain LICENSE) == ' M LICENSE' ]]
# init runs only on the base branch.
git -C "$existing" checkout -q -b feature
fails_with 'Switch to main' defaults_init "$existing"
git -C "$existing" checkout -q main

# version is the release tag of the tool's own clone, and unknown for a copy outside one.
tool_clone=$test_root/tool
mkdir -p "$tool_clone/nested" "$test_root/loose"
git -C "$tool_clone" init -q
cp "$script_dir/gh-release-flow" "$tool_clone/"
cp "$script_dir/gh-release-flow" "$tool_clone/nested/"
cp "$script_dir/gh-release-flow" "$test_root/loose/"
git -C "$tool_clone" -c user.name=t -c user.email=t@example.com commit --allow-empty -qm 'release'
git -C "$tool_clone" tag v3.2.1
[[ $(cd "$repo" && "$tool_clone/gh-release-flow" version) == 'gh-release-flow v3.2.1' ]]
[[ $(GIT_DIR=$repo/.git "$tool_clone/gh-release-flow" --version) == 'gh-release-flow v3.2.1' ]]
git -C "$tool_clone" -c user.name=t -c user.email=t@example.com commit --allow-empty -qm 'later'
[[ $("$tool_clone/gh-release-flow" version) == 'gh-release-flow v3.2.1-1-g'* ]]
[[ $("$tool_clone/nested/gh-release-flow" version) == 'gh-release-flow unknown' ]]
[[ $("$test_root/loose/gh-release-flow" version) == 'gh-release-flow unknown' ]]
if "$script_dir/gh-release-flow" version extra >/dev/null 2>&1; then
	echo 'version accepted an argument' >&2
	exit 1
fi

source "$script_dir/gh-release-flow"
read_version V1.2.3
[[ $VERSION == v1.2.3 && $REL_BRANCH == dev/v1.2.3 ]]
for invalid_version in v1.2.3-.. v1.2.3-foo.; do
	if (read_version "$invalid_version" >/dev/null 2>&1); then
		echo "invalid branch version accepted: $invalid_version" >&2
		exit 1
	fi
done
(
	cd "$repo"
	# origin/main holds v0.1.0; the unreachable v9.0.0 and the non-release v1 must not be shown.
	git tag v1 origin/main
	VERSION=''
	[[ $(read_version <<<'v0.2.0') == '==> Latest release: v0.1.0' ]]
	# Changelog links use REPO, else the push repository.
	PUSH_REPO=github.com/acme/widget VERSION=v0.4.0 generate_pr_body
	grep -Fq 'https://github.com/acme/widget/commit/' "$PR_BODY_FILE"
	rm -f "$PR_BODY_FILE"
	PUSH_REPO=github.com/acme/widget VERSION=v0.4.0 REPO=acme/other generate_pr_body
	grep -Fq 'https://github.com/acme/other/compare/v0.1.0...v0.4.0' "$PR_BODY_FILE"
	rm -f "$PR_BODY_FILE"
)
printf ' %s tests passed in %ss\n' "$ok_tag" "$SECONDS"
