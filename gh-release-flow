#!/usr/bin/env bash
set -euo pipefail

DEFAULT_BASE_BRANCH=${DEFAULT_BASE_BRANCH:-main}
RELEASE_WORKFLOW=${RELEASE_WORKFLOW:-release.yml}
REPO=${REPO:-}
CONFIRM=${CONFIRM:-1}
PR=${PR:-}
[[ -z $REPO ]] || export GH_REPO=$REPO
export GH_PAGER=cat
version_re='^v[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.-]+)?$'
make_marker='# Written by gh release-flow setup-make, which replaces it on each run.'

die() {
	echo "ERROR: $*" >&2
	exit 1
}

tree_dirty() {
	! git diff --quiet || ! git diff --cached --quiet
}

require_clean() {
	[[ $(git rev-parse --is-inside-work-tree 2>/dev/null) == true ]] ||
		die 'Not inside a Git working tree.'
	if tree_dirty; then
		die 'Working tree not clean. Commit or stash changes first.'
	fi
}

require_gh() {
	command -v gh >/dev/null 2>&1 ||
		die 'GitHub CLI (gh) not found. Install it from https://cli.github.com/'
}

# Sets PUSH_REPO (host/owner/name) for a remote and points gh at it, unless REPO chose a repository.
use_push_repo() {
	local remote_url
	if ! remote_url=$(git remote get-url "$1") ||
		! PUSH_REPO=$(gh repo view "$remote_url" --json url --jq '.url | sub("^https?://"; "")'); then
		die "Unable to identify the GitHub repository behind remote '$1'."
	fi
	if [[ -z $REPO ]]; then
		export GH_REPO=$PUSH_REPO
		echo "==> Using GitHub repository $PUSH_REPO"
	fi
}

find_pr() {
	local state=$1 owner=$2
	gh pr list --base "$DEFAULT_BASE_BRANCH" --head "$BRANCH" \
		--state "$state" --json number,headRepositoryOwner \
		--jq "map(select(.headRepositoryOwner.login == \"$owner\")) | .[0].number // empty"
}

latest_tag() {
	git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' "origin/$DEFAULT_BASE_BRANCH" 2>/dev/null || true
}

# The tool's own version is the release tag of its git clone, which is how gh installs it; VERSION is
# the release being cut. A copy outside its own clone has no version.
tool_version() {
	local dir top
	dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
	# A hook's GIT_DIR would point git at the repository being released.
	top=$(env -u GIT_DIR -u GIT_WORK_TREE git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || top=''
	if [[ $top == "$dir" ]]; then
		env -u GIT_DIR -u GIT_WORK_TREE git -C "$dir" describe --tags --match 'v[0-9]*' 2>/dev/null && return
	fi
	echo unknown
}

read_version() {
	local candidate=${1:-${VERSION:-}} latest
	if [[ -z $candidate ]]; then
		latest=$(latest_tag)
		[[ -n $latest ]] && echo "==> Latest release: $latest" || echo '==> No release tag yet.'
		read -r -p 'Enter version (e.g. v1.2.3): ' candidate || true
	fi
	VERSION=${candidate/#V/v}
	[[ $VERSION =~ $version_re ]] ||
		die "VERSION must look like v1.2.3 or v1.2.3-rc.1 (got '$VERSION')"
	REL_BRANCH=dev/$VERSION
	git check-ref-format --branch "$REL_BRANCH" >/dev/null 2>&1 ||
		die "VERSION cannot form a valid Git branch (got '$VERSION')"
}

read_release_branch() {
	BRANCH=$(git rev-parse --abbrev-ref HEAD)
	[[ $BRANCH =~ ^dev/${version_re#^} ]] ||
		die "Current branch '$BRANCH' is not a dev/v* release branch."
	VERSION=${BRANCH#dev/}
}

previous_tag() {
	git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' --exclude "$1" HEAD 2>/dev/null || true
}

# Prints one changelog entry: the scope in bold, the text, and its links in parentheses.
changelog_entry() {
	local scope=$1 text=$2 links=$3 author=$4 entry='- '
	[[ -z $scope ]] || entry+="**$scope**: "
	entry+=$text
	[[ -z $links ]] || entry+=" ($links)"
	[[ -z $author ]] || entry+=" by $author"
	printf '%s\n' "$entry"
}

# The GitHub login behind a commit, or nothing when GitHub names no account or cannot be asked.
commit_login() {
	local login
	login=$(gh api "repos/$1/commits/$2" --jq '.author.login // ""' 2>/dev/null) || return 0
	[[ ! $login =~ ^[A-Za-z0-9-]+$ ]] || printf '%s' "$login"
}

# The merged pull request a commit came through, other than a release PR, or nothing. On an error,
# gh api prints GitHub's answer on stdout, so the output is used only when the call succeeds.
commit_pr() {
	local pr
	pr=$(gh api "repos/$1/commits/$2/pulls" \
		--jq '[.[] | select(.merged_at != null and (.head.ref | startswith("dev/v") | not)) | .number] | first // empty' \
		2>/dev/null) || return 0
	[[ ! $pr =~ ^[0-9]+$ ]] || printf '%s' "$pr"
}

# Prints "severity<TAB>reporters" for a security advisory, or fails when GitHub cannot show it.
advisory_fields() {
	local fields
	fields=$(gh api "repos/$1/security-advisories/$2" \
		--jq '[.severity, ([.credits_detailed[]? | select(.type == "reporter" or .type == "finder") | "@" + .user.login] | join(" "))] | @tsv' \
		2>/dev/null) || return 1
	[[ $fields =~ ^(low|medium|moderate|high|critical)$'\t' ]] || return 1
	printf '%s\n' "$fields"
}

generate_changelog() {
	local version=$1 previous=$2 commit_range=$3 repo=$4
	local owner=${repo%%/*} url="https://github.com/$repo"
	local subject hash author email body line type scope bang text key login pr links n
	local security breaking severity reporters advisory
	local -a log_args=(--no-show-signature --reverse --no-merges --pretty=format:'%s%x00%H%x00%aN%x00%aE%x00%b%x00')
	local -a sections=(feat fix perf refactor docs style test build ci chore other)
	local -A title=([feat]=Features [fix]='Bug Fixes' [perf]=Performance [refactor]=Refactoring
		[docs]=Documentation [style]=Style [test]=Tests [build]=Build [ci]=CI/CD [chore]=Chores [other]='Other Changes')
	local -A entries=() logins=() earlier=() first_link=()
	local breaking_entries='' security_entries='' newcomers=''
	[[ -n $commit_range ]] && log_args+=("$commit_range")
	# Emails with a commit in the previous release: their authors are not new.
	if [[ -n $previous ]]; then
		while IFS= read -r email; do
			earlier[${email,,}]=1
		done < <(git log --format='%aE' "$previous")
	fi

	while IFS= read -r -d '' subject &&
		IFS= read -r -d '' hash &&
		IFS= read -r -d '' author &&
		IFS= read -r -d '' email &&
		IFS= read -r -d '' body; do
		subject=${subject#$'\n'}
		[[ -n $subject ]] || continue
		[[ $author != 'github-actions[bot]' ]] || continue
		[[ ! $subject =~ ^[Cc]hangelog$ ]] || continue

		# The subject: type(scope)!: text, or anything else under Other Changes.
		type=other scope='' bang='' text=$subject
		if [[ $subject =~ ^([A-Za-z]+)(\(([^\)]*)\))?(!)?:\ +(.+)$ ]]; then
			type=${BASH_REMATCH[1],,} scope=${BASH_REMATCH[3]} bang=${BASH_REMATCH[4]} text=${BASH_REMATCH[5]}
			[[ -n ${title[$type]+set} && $type != other ]] || { type=other scope='' text=$subject; }
		fi

		# The footers: Security, BREAKING CHANGE, and the issues it fixes or refers to.
		security='' breaking='' links=''
		local -a issues=()
		while IFS= read -r line; do
			line=${line%$'\r'}
			if [[ $line =~ ^Security:[[:space:]]*([^[:space:]].*)$ ]]; then
				security=${BASH_REMATCH[1]%"${BASH_REMATCH[1]##*[![:space:]]}"}
			elif [[ $line =~ ^BREAKING[\ -]CHANGE:[[:space:]]*(.+)$ ]]; then
				breaking=${BASH_REMATCH[1]}
			elif [[ ${line,,} =~ ^(close[sd]?|fix(e[sd])?|resolve[sd]?|refs?):?[[:space:]]+(#[0-9]+([[:space:]]*,[[:space:]]*#[0-9]+)*)[[:space:]]*$ ]]; then
				for n in ${BASH_REMATCH[3]//[#,]/ }; do
					[[ " ${issues[*]} " == *" $n "* ]] || issues+=("$n")
				done
			fi
		done <<<"$body"
		[[ -z $bang || -n $breaking ]] || breaking=$text

		# The author, named only when it is someone other than the repository's owner.
		key=${email,,}
		[[ -n $key ]] || key="name:$author"
		[[ -n ${logins[$key]+set} ]] || logins[$key]=$(commit_login "$repo" "$hash")
		login=${logins[$key]}
		pr=$(commit_pr "$repo" "$hash")
		if [[ -n $pr ]]; then
			links="[#$pr]($url/pull/$pr)"
		else
			links="[${hash:0:7}]($url/commit/$hash)"
		fi
		for n in "${issues[@]}"; do
			[[ $n == "$pr" ]] || links+=", [#$n]($url/issues/$n)"
		done
		if [[ -n $login && ${login,,} == "${owner,,}" ]]; then
			login=''
		elif [[ -n $login && -n $previous && -z ${earlier[$key]+set} && -z ${first_link[$login]+set} ]]; then
			first_link[$login]=${links%%,*}
			newcomers+="- @$login made their first contribution in ${first_link[$login]}"$'\n'
		fi

		if [[ -n $breaking ]]; then
			breaking_entries+=$(changelog_entry "$scope" "$breaking" "$links" "${login:+@$login}")$'\n'
		fi
		if [[ -n $security ]]; then
			severity='' reporters='' advisory=''
			if [[ $security =~ ^GHSA(-[23456789cfghjmpqrvwx]{4}){3}$ ]]; then
				advisory=$security
				if IFS=$'\t' read -r severity reporters < <(advisory_fields "$repo" "$advisory"); then
					:
				else
					echo "WARNING: Could not read advisory $advisory; its entry has no severity." >&2
				fi
			elif [[ ${security,,} =~ ^(low|medium|moderate|high|critical)$ ]]; then
				severity=${security,,}
			else
				echo "WARNING: Security footer '$security' on ${hash:0:7} is neither a GHSA id nor low, moderate, high or critical; listed under its type." >&2
				security=''
			fi
		fi
		if [[ -n $security ]]; then
			line=$(changelog_entry "$scope" "$text" "${advisory:+[$advisory]($url/security/advisories/$advisory), }$links" "${login:+@$login}")
			# GitHub's API says medium where its pages say Moderate.
			[[ $severity != medium ]] || severity=moderate
			[[ -z $severity ]] || line="- [${severity^}] ${line#- }"
			[[ -z $reporters ]] || line+=" reporter $reporters"
			security_entries+=$line$'\n'
		else
			entries[$type]+=$(changelog_entry "$scope" "$text" "$links" "${login:+@$login}")$'\n'
		fi
	done < <(git log "${log_args[@]}")

	printf "## What's Changed\n\n"
	[[ -z $breaking_entries ]] || printf '### Breaking Changes\n\n%s\n' "$breaking_entries"
	[[ -z $security_entries ]] || printf '### Security\n\n%s\n' "$security_entries"
	for type in "${sections[@]}"; do
		[[ -z ${entries[$type]:-} ]] || printf '### %s\n\n%s\n' "${title[$type]}" "${entries[$type]}"
	done
	[[ -z $newcomers ]] || printf '## New Contributors\n\n%s\n' "$newcomers"
	if [[ -n $previous ]]; then
		printf '**Full Changelog**: %s/compare/%s...%s\n' "$url" "$previous" "$version"
	else
		printf '**Full Changelog**: %s/releases/tag/%s\n' "$url" "$version"
	fi
}

generate_pr_body() {
	local repo_name=${REPO:-${GITHUB_REPOSITORY:-${PUSH_REPO#*/}}} previous commit_range
	previous=$(previous_tag "$VERSION")
	commit_range=''
	[[ -z $previous ]] || commit_range=$previous..HEAD
	PR_BODY_FILE=$(mktemp)
	generate_changelog "$VERSION" "$previous" "$commit_range" "$repo_name" >"$PR_BODY_FILE"
}

start_dev() {
	local moving=0 answer
	# Changes on the protected base branch may move to the release branch; the user is asked below.
	if [[ $(git rev-parse --abbrev-ref HEAD 2>/dev/null) == "$DEFAULT_BASE_BRANCH" ]] && tree_dirty; then
		moving=1
	else
		require_clean
	fi
	git fetch origin
	read_version "${1:-}"
	if git show-ref --verify --quiet refs/heads/dev || git show-ref --verify --quiet refs/remotes/origin/dev; then
		die "A branch named 'dev' exists, so Git cannot create $REL_BRANCH. Rename or delete 'dev' first."
	fi
	if git ls-remote --exit-code --tags origin "refs/tags/$VERSION" >/dev/null; then
		die "Tag $VERSION already exists on origin. Pick a new version."
	fi
	if ((moving == 1)); then
		echo "==> Uncommitted changes on $DEFAULT_BASE_BRANCH:"
		git status --short --untracked-files=no
		printf '    Move them to %s? [y/N] ' "$REL_BRANCH"
		read -r answer || answer=''
		[[ $answer =~ ^[yY]([eE][sS])?$ ]] ||
			die 'Working tree not clean. Commit or stash changes first.'
	fi
	# Git carries uncommitted changes through these steps, or refuses and leaves them untouched.
	git checkout "$DEFAULT_BASE_BRANCH"
	git pull --ff-only
	if git show-ref --verify --quiet "refs/heads/$REL_BRANCH"; then
		echo "==> Branch $REL_BRANCH already exists, checking it out…"
		git checkout "$REL_BRANCH"
	elif git show-ref --verify --quiet "refs/remotes/origin/$REL_BRANCH"; then
		echo "==> Branch $REL_BRANCH exists on origin, checking it out…"
		git checkout --track "origin/$REL_BRANCH"
	else
		echo "==> Creating branch $REL_BRANCH from $DEFAULT_BASE_BRANCH…"
		git checkout -b "$REL_BRANCH" "$DEFAULT_BASE_BRANCH"
		git push --no-follow-tags -u origin "$REL_BRANCH"
	fi
	echo "OK: Ready on branch $REL_BRANCH"
	((moving == 0)) || echo "    Your uncommitted changes came along. Commit them, then run 'gh release-flow open-pr'."
}

open_pr() {
	local push_remote push_owner remote_ref remote_info behind ahead
	local prnum check_output check_status start_time total_time pr_url i
	local open_pr_status=0
	require_clean
	require_gh
	read_release_branch
	trap 'rm -f "${PR_BODY_FILE:-}"' EXIT

	push_remote=$(git config --get "branch.$BRANCH.remote" 2>/dev/null || echo origin)
	use_push_repo "$push_remote"
	IFS=/ read -r _ push_owner _ <<<"$PUSH_REPO"
	remote_ref=refs/remotes/$push_remote/$BRANCH
	if ! remote_info=$(git ls-remote --heads "$push_remote" "refs/heads/$BRANCH"); then
		die "Unable to query $push_remote/$BRANCH; refusing to use a stale tracking ref."
	fi
	if [[ -z $remote_info ]]; then
		echo "==> $push_remote/$BRANCH does not exist yet - publishing…"
		git push --no-follow-tags -u "$push_remote" "HEAD:refs/heads/$BRANCH"
	else
		git fetch --quiet "$push_remote" "+refs/heads/$BRANCH:$remote_ref" ||
			die "Unable to fetch $push_remote/$BRANCH; refusing to use a stale tracking ref."
		behind=$(git rev-list --count "HEAD..$remote_ref")
		ahead=$(git rev-list --count "$remote_ref..HEAD")
		if ((behind > 0 && ahead > 0)); then
			die "$BRANCH has diverged from $push_remote/$BRANCH ($behind behind, $ahead ahead). Reconcile deliberately, then re-run."
		fi
		((behind == 0)) || die "$BRANCH is $behind commit(s) behind $push_remote/$BRANCH. Reconcile first, then re-run."
		if ((ahead > 0)); then
			echo "==> Publishing $ahead local commit(s) to $push_remote/$BRANCH…"
			git push --no-follow-tags "$push_remote" "HEAD:refs/heads/$BRANCH"
		else
			echo "==> $BRANCH already in sync with $push_remote/$BRANCH - nothing to push."
		fi
	fi

	prnum=$(find_pr open "$push_owner") ||
		die "Unable to query open PRs for $BRANCH."
	echo '==> Writing the changelog; GitHub is asked about each commit…'
	generate_pr_body
	if [[ -n $prnum ]]; then
		echo "==> An open PR (#$prnum) from $BRANCH -> $DEFAULT_BASE_BRANCH already exists."
		echo '==> Refreshing PR body with the latest changelog…'
		gh pr edit "$prnum" --body-file "$PR_BODY_FILE"
		echo 'OK: PR body updated.'
	else
		echo "==> Opening PR: $BRANCH -> $DEFAULT_BASE_BRANCH…"
		gh pr create --base "$DEFAULT_BASE_BRANCH" --head "$BRANCH" \
			--title "Release $VERSION" --body-file "$PR_BODY_FILE"
		prnum=$(find_pr open "$push_owner")
	fi

	echo
	echo '==> Waiting for CI checks to register...'
	sleep 3
	for i in 1 2 3 4 5; do
		check_output=$(gh pr checks "$prnum" 2>&1 || true)
		grep -q 'no checks reported' <<<"$check_output" || break
		((i == 5)) || {
			echo "==> Retrying in 2s... (attempt $i/5)"
			sleep 2
		}
	done
	if grep -q 'no checks reported' <<<"$check_output"; then
		echo 'WARN: No CI checks detected after 11s. Skipping check wait.'
		echo '    Checks might start later - monitor the PR manually.'
	else
		echo "==> Waiting for checks to complete on PR #$prnum…"
		echo "    (Ctrl+C stops watching; re-run 'gh release-flow open-pr' to resume)"
		echo
		start_time=$(date +%s)
		check_status=0
		gh pr checks "$prnum" --watch --interval 5 || check_status=$?
		total_time=$(($(date +%s) - start_time))
		echo
		if ((check_status != 0)); then
			check_status=0
			gh pr checks "$prnum" >/dev/null 2>&1 || check_status=$?
		fi
		if ((check_status == 0)); then
			printf 'OK: All checks passed! (took %02d:%02d)\n' $((total_time / 60)) $((total_time % 60))
		elif ((check_status == 8)); then
			echo 'WARN: Check monitoring stopped while checks are still pending.'
			echo "    Re-run 'gh release-flow open-pr' to resume watching."
			open_pr_status=1
		else
			gh pr checks "$prnum" || true
			echo
			echo "ERROR: Checks failed on PR #$prnum."
			open_pr_status=1
		fi
	fi

	echo
	pr_url=$(gh pr view "$prnum" --json url --jq '.url' 2>/dev/null || true)
	[[ -z $pr_url ]] && echo "==> View PR #$prnum with: gh pr view $prnum" || echo "==> PR #$prnum: $pr_url"
	return "$open_pr_status"
}

merge_release() {
	local push_remote push_owner prnum='' pr_state='' release_head remote_info remote_head
	local pr_info pr_base pr_head pr_oid pr_owner pr_cross previous commit_count commit_scope answer merged_at
	local check_output check_status=0 workflow_tsv='' run_id status conclusion i
	local workflow_success=0 start_time total_time final_conclusion
	local cleanup_info release_info release_url release_name resume_hint
	require_clean
	require_gh
	gh run list --help 2>&1 | grep -q -- '--commit' ||
		die 'Update gh to 2.40 or newer: this flow needs gh run list --commit.'
	read_release_branch
	push_remote=$(git config --get "branch.$BRANCH.remote" 2>/dev/null || echo origin)
	use_push_repo "$push_remote"
	IFS=/ read -r _ push_owner _ <<<"$PUSH_REPO"

	if [[ -n $PR ]]; then
		prnum=$PR
		pr_state=$(gh pr view "$prnum" --json state --jq '.state') ||
			die "Unable to query PR #$prnum."
	else
		prnum=$(find_pr open "$push_owner") ||
			die "Unable to query open PRs for $BRANCH."
		pr_state=OPEN
		if [[ -z $prnum ]]; then
			prnum=$(find_pr merged "$push_owner") ||
				die "Unable to query merged PRs for $BRANCH."
			pr_state=MERGED
		fi
	fi
	[[ -n $prnum ]] ||
		die "No open or merged PR from $BRANCH to $DEFAULT_BASE_BRANCH."
	[[ $pr_state == OPEN || $pr_state == MERGED ]] ||
		die "PR #$prnum state is '$pr_state' (expected OPEN or MERGED)."
	pr_info=$(gh pr view "$prnum" \
		--json baseRefName,headRefName,headRefOid,headRepositoryOwner,isCrossRepository \
		--jq '[.baseRefName, .headRefName, .headRefOid, .headRepositoryOwner.login, .isCrossRepository] | @tsv')
	IFS=$'\t' read -r pr_base pr_head pr_oid pr_owner pr_cross <<<"$pr_info"
	[[ $pr_base == "$DEFAULT_BASE_BRANCH" && $pr_head == "$BRANCH" && -n $pr_oid && $pr_owner == "$push_owner" ]] ||
		die "PR #$prnum is not a $BRANCH -> $DEFAULT_BASE_BRANCH release PR."
	# A fork PR's release run gets a read-only token, so it can never publish.
	[[ $pr_cross == false ]] ||
		die "PR #$prnum comes from a fork. Push $BRANCH to the repository that receives the PR."

	if [[ $pr_state == MERGED ]]; then
		echo "==> PR #$prnum from $BRANCH is already merged - resuming release watch and cleanup."
		release_head=$pr_oid
	else
		echo "==> Checking status of PR #$prnum…"
		remote_info=$(git ls-remote --heads "$push_remote" "refs/heads/$BRANCH") ||
			die "Unable to query $push_remote/$BRANCH; refusing to merge an unsynchronized PR."
		[[ -n $remote_info ]] || die "$push_remote/$BRANCH does not exist; refusing to merge."
		release_head=$(git rev-parse HEAD)
		remote_head=${remote_info%%$'\t'*}
		[[ $release_head == "$remote_head" ]] ||
			die "Local HEAD is not synchronized with $push_remote/$BRANCH. Push or reconcile, then re-run."
		[[ $pr_oid == "$release_head" ]] ||
			die "PR #$prnum is not synchronized with local $BRANCH. Push or reconcile, then re-run."

		# Read checks only after the PR head matches HEAD, so they belong to the commit being merged.
		check_output=$(gh pr checks "$prnum" 2>&1) || check_status=$?
		if [[ $check_output == *'no checks reported'* ]]; then
			die "No CI checks are reported for PR #$prnum. Wait for checks, then re-run." \
				"A skip-ci marker such as [skip ci] in the last commit message blocks checks; push a new commit to clear it."
		fi
		if ((check_status != 0)); then
			printf '%s\n' "$check_output" >&2
			((check_status != 8)) ||
				die "Checks are still running on PR #$prnum. Wait for them to finish, then re-run."
			die "Checks have not passed on PR #$prnum. Run 'gh release-flow open-pr' to watch them."
		fi
		echo 'OK: All checks passed.'

		previous=$(previous_tag "$VERSION")
		if [[ -n $previous ]]; then
			commit_count=$(git rev-list --count "$previous..HEAD" 2>/dev/null || echo '?')
			commit_scope="since $previous"
		else
			commit_count=$(git rev-list --count HEAD)
			commit_scope=total
		fi
		echo
		echo "==> Ready to merge release $VERSION:"
		echo "    PR:      #$prnum ($BRANCH -> $DEFAULT_BASE_BRANCH)"
		echo "    Commits: $commit_count $commit_scope"
		echo "    Head:    $release_head"
		if [[ $CONFIRM == 0 ]]; then
			echo '==> CONFIRM=0 set - skipping confirmation prompt.'
		else
			printf '    Merge PR #%s into %s? [y/N] ' "$prnum" "$DEFAULT_BASE_BRANCH"
			read -r answer || answer=''
			[[ $answer =~ ^[yY]([eE][sS])?$ ]] || die 'Merge aborted.'
		fi
		echo
		echo "==> Merging PR #$prnum…"
		gh pr merge "$prnum" --merge --match-head-commit "$release_head" ||
			die 'Merge failed. Branch not deleted.'
	fi
	merged_at=$(gh pr view "$prnum" --json mergedAt --jq '.mergedAt // empty') ||
		die "Unable to determine when PR #$prnum was merged."
	[[ -n $merged_at ]] ||
		die "PR #$prnum is not merged yet; a merge queue may still be processing it. Re-run 'gh release-flow merge' after GitHub merges it."

	echo "==> Tag to be released: $VERSION"
	echo
	echo '==> Checking for release workflow...'
	sleep 2
	for ((i = 1; i <= 10; i++)); do
		workflow_tsv=$(gh run list --workflow="$RELEASE_WORKFLOW" \
			--event pull_request --commit "$release_head" --created ">=$merged_at" --limit 1 \
			--json databaseId,status,conclusion \
			--jq '.[0] // empty | [(.databaseId | tostring), .status, (.conclusion // "n/a")] | @tsv')
		[[ -z $workflow_tsv ]] || break
		echo "==> Waiting for workflow to start... (attempt $i/10)"
		sleep 2
	done
	[[ -n $workflow_tsv ]] ||
		die "Could not identify the $RELEASE_WORKFLOW run for $VERSION. Re-run after it starts."
	IFS=$'\t' read -r run_id status conclusion <<<"$workflow_tsv"
	echo '==> Release workflow found'
	echo "    Run ID: #$run_id"
	echo "    Status: $status"

	if [[ $status != completed ]]; then
		echo
		echo "==> Watching release workflow #$run_id..."
		echo "    (Ctrl+C stops watching; re-run 'gh release-flow merge' to resume)"
		echo
		start_time=$(date +%s)
		if gh run watch "$run_id" --exit-status; then
			total_time=$(($(date +%s) - start_time))
			printf 'OK: Release workflow completed! (took %02d:%02d)\n' $((total_time / 60)) $((total_time % 60))
			workflow_success=1
		else
			final_conclusion=$(gh run view "$run_id" \
				--json conclusion --jq '.conclusion // ""' 2>/dev/null || true)
			[[ -n $final_conclusion ]] ||
				die "Could not read the result of run #$run_id. Re-run 'gh release-flow merge' to resume."
			if [[ $final_conclusion == success ]]; then
				workflow_success=1
			else
				echo "ERROR: Release workflow failed (conclusion: $final_conclusion)"
				gh run view "$run_id" || true
			fi
		fi
	else
		echo "==> Workflow already completed: $conclusion"
		[[ $conclusion == success ]] && workflow_success=1
		gh run view "$run_id" || true
	fi

	echo
	if ((workflow_success == 1)); then
		echo "==> Cleaning up: deleting branch $BRANCH..."
		git checkout "$DEFAULT_BASE_BRANCH" ||
			die "Unable to check out $DEFAULT_BASE_BRANCH. If another worktree has it checked out, switch that worktree to another branch, then re-run 'gh release-flow merge'."
		resume_hint="Run 'git checkout $BRANCH', then re-run 'gh release-flow merge'."
		git pull --ff-only || die "Unable to update $DEFAULT_BASE_BRANCH. $resume_hint"
		git merge-base --is-ancestor "$release_head" "$DEFAULT_BASE_BRANCH" ||
			die "$BRANCH is not contained in $DEFAULT_BASE_BRANCH; leaving branch refs intact. $resume_hint"
		cleanup_info=$(git ls-remote --heads "$push_remote" "refs/heads/$BRANCH") ||
			die "Unable to query $push_remote/$BRANCH for safe cleanup. $resume_hint"
		if [[ -n $cleanup_info && ${cleanup_info%%$'\t'*} != "$release_head" ]]; then
			die "$push_remote/$BRANCH advanced after merge; leaving branch refs intact. Run 'git checkout $BRANCH' to review the new commits."
		fi
		if [[ -n $cleanup_info ]]; then
			git push --force-with-lease="refs/heads/$BRANCH:$release_head" \
				"$push_remote" ":refs/heads/$BRANCH" ||
				die "Unable to delete remote branch; local branch kept for retry. $resume_hint"
		fi
		# A stale tracking ref would let 'git branch -d' approve commits that are not in the base branch.
		git update-ref -d "refs/remotes/$push_remote/$BRANCH"
		git branch -d "$BRANCH" ||
			die "Unable to delete local branch $BRANCH. Review its commits with 'git log $DEFAULT_BASE_BRANCH..$BRANCH'."
		echo 'OK: Branch cleanup complete'
		release_info=$(gh release view "$VERSION" --json url,name --jq '"\(.url)\t\(.name)"' 2>/dev/null || true)
		IFS=$'\t' read -r release_url release_name <<<"$release_info"
		echo
		if [[ -z $release_url ]]; then
			echo "OK: Release $VERSION complete (no GitHub Release found for $VERSION)."
		else
			# gh release create --notes without --title leaves a release unnamed.
			if [[ -z $release_name ]]; then
				echo "WARNING: $RELEASE_WORKFLOW published $VERSION without a title; pass --title to gh release create."
				if gh release edit "$VERSION" --title "$VERSION" >/dev/null; then
					echo "OK: Release title set to $VERSION"
				else
					echo "WARNING: Unable to set the title. Run 'gh release edit $VERSION --title $VERSION'."
				fi
			fi
			echo "OK: Release $VERSION published: $release_url"
		fi
	else
		die "Workflow did not succeed. Keeping branch $BRANCH for debugging."
	fi
}

# Installs user-wide Make targets for the commands, and a make shell function that lists them in make help.
setup_make() {
	local dir=$HOME/.config/make targets functions answer rc line changed=0
	local makefiles_line function_line
	# make splits MAKEFILES at spaces, so it can never load the targets from such a home.
	[[ $HOME != *' '* ]] ||
		die 'make cannot load files from a home path with spaces. Use gh release-flow directly.'
	if [[ -e $dir/release-flow.mk && $(head -n 1 "$dir/release-flow.mk") != "$make_marker" ]]; then
		printf '    %s was not written by setup-make. Replace it? [y/N] ' "$dir/release-flow.mk"
		read -r answer || answer=''
		[[ $answer == [yY] ]] || die "Kept $dir/release-flow.mk. Move it away, then run setup-make again."
	fi

	targets=$(printf '%s\n' "$make_marker" \
		'.PHONY: init start-dev open-pr merge-release rf-version rf-upgrade' \
		'' \
		'init start-dev open-pr merge-release:' \
		$'\t@gh release-flow "$@"' \
		'' \
		'rf-version rf-upgrade:' \
		$'\t@gh release-flow "$(@:rf-%=%)"' \
		'' \
		'# Keep project Makefiles that read MAKEFILE_LIST unaware of this file.' \
		'MAKEFILE_LIST :=')
	# make help ends with the targets, a blank line after the project's own help when it has one, and so does plain
	# make when the default goal is help; they are all that plain make without a Makefile prints.
	# Other runs are untouched.
	functions=$(
		cat <<'EOF'
make() {
	local code=0 targets='init  start-dev  open-pr  merge-release  rf-version  rf-upgrade'
	# The target names are grey on a terminal, and never with NO_COLOR set.
	if [ -t 1 ] && [ -z "${NO_COLOR-}" ]; then
		targets=$(printf '\033[90m%s\033[0m' "$targets")
	fi
	targets=" release-flow:  $targets"
	if [ $# -eq 0 ] && [ ! -e GNUmakefile ] && [ ! -e makefile ] && [ ! -e Makefile ]; then
		printf '%s\n' "$targets"
		return 0
	fi
	if [ $# -eq 0 ]; then
		LC_ALL=C command make -pqn 2>/dev/null | grep -qx '.DEFAULT_GOAL := help' || {
			command make
			return
		}
	elif [ "$*" != help ]; then
		command make "$@"
		return
	fi
	case $(LC_ALL=C command make -q help 2>&1 >/dev/null) in
	*"No rule to make target 'help'"*) ;;
	*)
		command make help || code=$?
		echo
		;;
	esac
	printf '%s\n' "$targets"
	return "$code"
}
EOF
	)
	functions=$make_marker$'\n'$functions
	mkdir -p "$dir"
	printf '%s\n' "$targets" >"$dir/release-flow.mk"
	if [[ ! -e $dir/release-flow.sh || $(<"$dir/release-flow.sh") != "$functions" ]]; then
		printf '%s\n' "$functions" >"$dir/release-flow.sh"
		changed=1
	fi

	# shellcheck disable=SC2016
	makefiles_line='case " ${MAKEFILES:-} " in *" $HOME/.config/make/release-flow.mk "*) ;; *) export MAKEFILES="$HOME/.config/make/release-flow.mk${MAKEFILES:+ $MAKEFILES}" ;; esac'
	# shellcheck disable=SC2016
	function_line='[ ! -f "$HOME/.config/make/release-flow.sh" ] || . "$HOME/.config/make/release-flow.sh"'
	# The lines are plain sh, so zsh reads them too; .zshrc only gets them when it already exists.
	for rc in "$HOME/.bashrc" "${ZDOTDIR:-$HOME}/.zshrc"; do
		[[ $rc == "$HOME/.bashrc" || -e $rc ]] || continue
		for line in "$makefiles_line" "$function_line"; do
			grep -Fqxs -- "$line" "$rc" && continue
			if [[ -s $rc ]] && ! tail -c 1 "$rc" | grep -q '^$'; then
				printf '\n' >>"$rc"
			fi
			printf '%s\n' "$line" >>"$rc"
			changed=1
		done
	done
	if ((changed)); then
		echo 'OK: Make targets installed. Open a new terminal to load them.'
	else
		echo 'OK: Make targets are up to date.'
	fi
}

# Prints the release workflow that init writes, for the base branch given as $1.
release_workflow_template() {
	local template
	read -r -d '' template <<'EOF' || true
name: Release

on:
  pull_request:
    types: [closed]
    branches: ['__BASE_BRANCH__']

permissions:
  checks: read
  contents: write
  pull-requests: read

jobs:
  release:
    name: Publish release
    # Only merged release PRs from this repository: forks cannot publish.
    if: >-
      github.event.pull_request.merged == true &&
      github.event.pull_request.head.repo.full_name == github.repository &&
      startsWith(github.event.pull_request.head.ref, 'dev/v')
    runs-on: ubuntu-latest
    steps:
      - name: Require passing checks
        env:
          GH_TOKEN: ${{ github.token }}
          PR_NUMBER: ${{ github.event.pull_request.number }}
        run: |
          # This workflow is itself one of the PR's checks, so leave it out.
          checks=$(gh pr checks "$PR_NUMBER" --repo "$GITHUB_REPOSITORY" --json bucket,workflow)
          jq -e --arg self "$GITHUB_WORKFLOW" '[.[] | select(.workflow != $self)] |
            length > 0 and all(.[]; .bucket == "pass" or .bucket == "skipping")' <<< "$checks"
      - name: Publish release
        env:
          GH_TOKEN: ${{ github.token }}
          RELEASE_BRANCH: ${{ github.event.pull_request.head.ref }}
          MERGE_SHA: ${{ github.event.pull_request.merge_commit_sha }}
          PR_BODY: ${{ github.event.pull_request.body }}
        run: |
          [[ "$RELEASE_BRANCH" =~ ^dev/v[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.-]+)?$ ]]
          tag=${RELEASE_BRANCH#dev/}
          release_args=()
          [[ "$tag" == *-* ]] && release_args+=(--prerelease)
          # The release PR body holds the grouped changelog written by open-pr.
          if [[ -n $PR_BODY ]]; then release_args+=(--notes "$PR_BODY"); else release_args+=(--generate-notes); fi
          # Without --title, a release with --notes has no name; name it after its tag.
          gh release create "$tag" --repo "$GITHUB_REPOSITORY" --title "$tag" --target "$MERGE_SHA" "${release_args[@]}"
EOF
	printf '%s' "${template//__BASE_BRANCH__/$1}"
}

# The settings files init knows, in the order it applies them, each with its method and its path after
# repos/{owner}/{repo}. A .json file is the request body; any other file means a PUT without a body.
# GitHub turns on automated security fixes only after vulnerability alerts, and CodeQL default setup
# comes last, after the push, so it has code to analyse.
settings_calls=(
	'repo.json PATCH'
	'actions-permissions.json PUT /actions/permissions'
	'actions-workflow.json PUT /actions/permissions/workflow'
	'vulnerability-alerts PUT /vulnerability-alerts'
	'automated-security-fixes PUT /automated-security-fixes'
	'private-vulnerability-reporting PUT /private-vulnerability-reporting'
	'immutable-releases PUT /immutable-releases'
	'code-scanning-default-setup.json PATCH /code-scanning/default-setup'
)

# Asks a [y/N] question on the terminal; only y or yes says yes.
confirm() {
	local answer
	printf '    %s [y/N] ' "$1"
	read -r answer || answer=''
	# Without a terminal the answer is not echoed, so end the prompt line here.
	[[ -t 0 ]] || echo
	[[ $answer =~ ^[yY]([eE][sS])?$ ]]
}

# Writes a known-good release workflow into the repository, where merge looks for it: init without defaults.
write_release_workflow() {
	local force=$1 root path content
	[[ $(git rev-parse --is-inside-work-tree 2>/dev/null) == true ]] ||
		die 'Not inside a Git working tree.'
	root=$(git rev-parse --show-toplevel)
	path=$root/.github/workflows/$RELEASE_WORKFLOW
	content=$(release_workflow_template "$DEFAULT_BASE_BRANCH")
	if [[ -e $path ]]; then
		if [[ $(<"$path") == "$content" ]]; then
			echo "OK: .github/workflows/$RELEASE_WORKFLOW is up to date."
			return
		fi
		((force)) ||
			die ".github/workflows/$RELEASE_WORKFLOW already exists and differs. Review it, or run 'gh release-flow init --force' to replace it."
	fi
	mkdir -p "$root/.github/workflows"
	printf '%s\n' "$content" >"$path"
	echo "OK: Wrote .github/workflows/$RELEASE_WORKFLOW for releases merged into $DEFAULT_BASE_BRANCH."
	echo "    Review and commit it to $DEFAULT_BASE_BRANCH, then run 'gh release-flow start-dev'."
}

# Downloads <owner>/.github/defaults/ for the owner $1 into DEFAULTS_DIR, through the Git tree and blob API,
# and fills the caller's default_files, ruleset_files, ruleset_names and ruleset_targets. Returns 1 when the
# owner has no defaults/ folder there. init reads these files as data and never runs them.
fetch_defaults() {
	local owner=$1 dir=$DEFAULTS_DIR listing mode sha path rel entry known meta rs_name rs_target
	if ! listing=$(gh api "repos/$owner/.github/git/trees/HEAD?recursive=1" --jq '
		if .truncated then error("the file list of \(.url) is truncated") else
			.tree[] | select(.type == "blob" and (.path | startswith("defaults/"))) | [.mode, .sha, .path] | @tsv
		end' 2>"$dir/error"); then
		# No .github repository, or an empty one, means no defaults either.
		grep -Eq 'HTTP (404|409)' "$dir/error" && return 1
		cat -- "$dir/error" >&2
		die "Unable to read the defaults in $owner/.github."
	fi
	[[ -n $listing ]] || return 1
	echo "==> Reading the defaults in $owner/.github…"
	while IFS=$'\t' read -r mode sha path; do
		rel=${path#defaults/}
		# A path that climbs out of the repository or into .git would write where init must not.
		case /$rel/ in
		*/../* | */./* | */[.][gG][iI][tT]/* | *\\*) die "Refusing the defaults path '$path'." ;;
		esac
		known=1
		case $rel in
		files/.github/workflows/"$RELEASE_WORKFLOW")
			echo "==> Skipped $path: the release workflow comes from gh-release-flow."
			continue
			;;
		files/*)
			[[ $mode != 120000 ]] || die "$path in $owner/.github is a symbolic link; defaults/files/ holds regular files only."
			default_files+=("${rel#files/}")
			;;
		settings/*/* | rulesets/*/*) known=0 ;;
		settings/*)
			known=0
			for entry in "${settings_calls[@]}"; do
				[[ ${entry%% *} != "${rel#settings/}" ]] || known=1
			done
			;;
		rulesets/*.json)
			meta=$(gh api "repos/$owner/.github/git/blobs/$sha" --jq '.content | @base64d | fromjson | [.name, .target] | @tsv') ||
				die "$path in $owner/.github must hold one JSON object."
			IFS=$'\t' read -r rs_name rs_target <<<"$meta"
			[[ -n $rs_name && ($rs_target == branch || $rs_target == tag) ]] ||
				die "$path in $owner/.github needs a top-level name, and a target of branch or tag."
			ruleset_files+=("$rel")
			ruleset_names+=("$rs_name")
			ruleset_targets+=("$rs_target")
			;;
		*) known=0 ;;
		esac
		# A newer convention may add files; an older gh-release-flow reports them instead of guessing.
		if ((known == 0)); then
			echo "==> Skipped $path: this version of gh-release-flow does not know this file."
			continue
		fi
		mkdir -p -- "$dir/${rel%/*}"
		if [[ $rel == settings/* && $rel != *.json ]]; then
			: >"$dir/$rel" # The file being there is the setting; its content is not used.
		else
			gh api "repos/$owner/.github/git/blobs/$sha" -H 'Accept: application/vnd.github.raw+json' >"$dir/$rel" ||
				die "Unable to download $path from $owner/.github."
		fi
	done <<<"$listing"
}

# Prints the items $2... joined with the separator $1.
join_list() {
	local separator=$1 text='' item
	shift
	for item in "$@"; do
		text+=$separator$item
	done
	printf '%s' "${text#"$separator"}"
}

# Stops init after the call for item $1 (counted from 0) of the items $3... failed with the message $2, first
# saying which items were done before it and which were not, so a step never stops half done unannounced.
stop_partway() {
	local failed=$1 message=$2 done_items='' left_items='' i=0 item
	shift 2
	for item in "$@"; do
		if ((i < failed)); then
			done_items+=", $item"
		else
			left_items+=", $item"
		fi
		i=$((i + 1))
	done
	done_items=${done_items#, }
	echo "    Done: ${done_items:-none}" >&2
	echo "    Not done: ${left_items#, }" >&2
	die "$message"
}

# Replaces {{owner}}, {{repo}} and {{year}} in the file $1 with $2, $3 and $4, and keeps every other byte.
fill_placeholders() {
	local text owner_tag='{{owner}}' repo_tag='{{repo}}' year_tag='{{year}}'
	grep -Fq -e "$owner_tag" -e "$repo_tag" -e "$year_tag" -- "$1" || return 0
	IFS= read -r -d '' text <"$1" || true
	text=${text//"$owner_tag"/$2}
	text=${text//"$repo_tag"/$3}
	text=${text//"$year_tag"/$4}
	printf '%s' "$text" >"$1"
}

# Sets up the repository in the current folder from <owner>/.github/defaults/, or, when the owner has no
# defaults, writes the release workflow only, as init always did.
init_workflow() {
	local force=0 owner name
	local -a default_files=() ruleset_files=() ruleset_names=() ruleset_targets=()
	while (($#)); do
		case $1 in
		--force) force=1 ;;
		*) die "init accepts only --force, not '$1'." ;;
		esac
		shift
	done
	[[ $RELEASE_WORKFLOW =~ ^[A-Za-z0-9._-]+\.ya?ml$ ]] ||
		die "init needs RELEASE_WORKFLOW to be a file name ending in .yml or .yaml, not '$RELEASE_WORKFLOW'."
	[[ $DEFAULT_BASE_BRANCH =~ ^[A-Za-z0-9._/-]+$ ]] ||
		die "init cannot write DEFAULT_BASE_BRANCH '$DEFAULT_BASE_BRANCH' into a workflow."
	require_gh

	# 1. The defaults belong to origin's owner, or, without origin, to the signed-in user.
	if [[ $(git rev-parse --is-inside-work-tree 2>/dev/null) == true ]] && git remote get-url origin >/dev/null 2>&1; then
		use_push_repo origin
		# Every gh api call goes to origin's host.
		IFS=/ read -r GH_HOST owner name <<<"$PUSH_REPO"
		export GH_HOST
	else
		owner=$(gh api user --jq .login) || owner=''
		[[ -n $owner ]] || die "Unable to read your GitHub user. Run 'gh auth login' first."
		name=''
	fi
	DEFAULTS_DIR=$(mktemp -d)
	trap 'rm -rf -- "$DEFAULTS_DIR"' EXIT
	if ! fetch_defaults "$owner"; then
		echo "==> Found no defaults/ folder in $owner/.github, so init writes the release workflow only."
		write_release_workflow "$force"
		return
	fi
	init_from_defaults "$force" "$owner" "$name"
}

# Renames the current branch $1 to the base branch $2 when it is the repository's default under another name,
# such as the master of a Git without init.defaultBranch, and $2 exists neither here nor on origin. With
# origin's repository $3/$4, a branch that is on GitHub must be its default branch, and GitHub renames it after
# a yes; one that is not there yet, like one with no origin, must be the only local branch. Writes the request
# body into the folder $5, sets RENAMED_WHERE for the summary, and fails, changing nothing, when it does not apply.
rename_to_base() {
	local branch=$1 base=$2 owner=$3 name=$4 dir=$5 on_origin='' default local_refs
	RENAMED_WHERE=''
	git show-ref --verify --quiet "refs/heads/$base" && return 1
	if [[ -n $name ]]; then
		[[ -z $(git ls-remote --heads origin "refs/heads/$base") ]] || return 1
		on_origin=$(git ls-remote --heads origin "refs/heads/$branch") ||
			die "Unable to query origin/$branch."
	fi
	if [[ -n $on_origin ]]; then
		default=$(gh api "repos/$owner/$name" --jq .default_branch) ||
			die "Unable to read the default branch of $owner/$name."
		[[ $default == "$branch" ]] || return 1
		echo "==> init sets up $base, but $owner/$name names its default branch $branch."
		echo '    GitHub moves its pull requests and branch protection to the new name and redirects the old one.'
		confirm "Rename $branch to $base on $owner/$name and here?" ||
			die "init sets up $base. Rename $branch to $base, or set DEFAULT_BASE_BRANCH=$branch, then run init again."
		printf '{"new_name": "%s"}\n' "$base" >"$dir/branch-rename.json"
		gh api "repos/$owner/$name/branches/$branch/rename" --method POST --input "$dir/branch-rename.json" --silent ||
			die "Unable to rename $branch to $base on $owner/$name. Rename it there, then run init again."
		RENAMED_WHERE=" here and on $owner/$name"
	else
		local_refs=$(git for-each-ref --format='%(refname)' refs/heads/)
		[[ -z $local_refs || $local_refs == "refs/heads/$branch" ]] || return 1
	fi
	# An unborn branch has no ref for git branch -m to move, so HEAD alone is pointed at the new name.
	if git rev-parse --quiet --verify HEAD >/dev/null; then
		git branch -m "$branch" "$base"
	else
		git symbolic-ref HEAD "refs/heads/$base"
	fi
	if [[ -n $on_origin ]]; then
		[[ -z $(git config --get "branch.$base.merge") ]] || git config "branch.$base.merge" "refs/heads/$base"
		git fetch --quiet --prune origin || die "Renamed $branch to $base, but unable to fetch origin."
		! git show-ref --verify --quiet refs/remotes/origin/HEAD || git remote set-head origin "$base" >/dev/null
	fi
	echo "OK: Renamed branch $branch to $base${RENAMED_WHERE}."
}

# Steps 2 to 7 of init with defaults, for --force $1, the owner $2 and the repository name $3 (empty without
# origin): Git, the GitHub repository, the files, their commit and push, the settings and the rulesets, then
# one summary line per step. Each outward action asks first, and declining skips that step only.
init_from_defaults() {
	local force=$1 owner=$2 name=$3 base=$DEFAULT_BASE_BRANCH dir=$DEFAULTS_DIR
	local branch root folder rulesets remote_info year rel i file method path list push_line line
	local have_base=0 branch_ruleset=0 codeql_held=0 kept_rulesets='' held_rulesets=''
	local -a summary=() plan=() to_write=() kept=() pending=() push_args=() apply=() names=() api_args=() create=() parts=()
	summary+=("Defaults|done, read from $owner/.github")

	# 2. Git: a new repository on the base branch, or the current one, which must be on the base branch.
	if [[ $(git rev-parse --is-inside-work-tree 2>/dev/null) == true ]]; then
		summary+=('Git|already done')
	else
		# Inside a .git folder, git init would nest a repository in it.
		if git rev-parse --git-dir >/dev/null 2>&1; then
			die 'Not inside a Git working tree.'
		fi
		git init -q -b "$base"
		echo "OK: Created a Git repository on branch $base."
		summary+=("Git|done, created a repository on $base")
	fi
	root=$(git rev-parse --show-toplevel)
	cd -- "$root"
	branch=$(git symbolic-ref --quiet --short HEAD) || branch=''
	if [[ -n $branch && $branch != "$base" ]] && rename_to_base "$branch" "$base" "$owner" "$name" "$dir"; then
		summary[${#summary[@]} - 1]="Git|done, renamed $branch to $base$RENAMED_WHERE"
		branch=$base
	fi
	[[ $branch == "$base" ]] ||
		die "init sets up $base, but the current branch is ${branch:-a detached HEAD}. Switch to $base, then run init again."

	# 3. The GitHub repository: origin's, or a new public one named after the folder.
	if [[ -n $name ]]; then
		summary+=("Repository|already done, $owner/$name")
	else
		folder=${root##*/}
		echo '==> This folder has no origin remote.'
		confirm "Create $owner/$folder (public)?" ||
			die "init needs a GitHub repository. To use an existing one, run 'git remote add origin <its URL>', then run 'gh release-flow init' again."
		gh repo create "$owner/$folder" --public --source . --remote origin ||
			die "Unable to create $owner/$folder. If it exists, run 'git remote add origin <its URL>', then run 'gh release-flow init' again."
		use_push_repo origin
		IFS=/ read -r GH_HOST owner name <<<"$PUSH_REPO"
		export GH_HOST
		summary+=("Repository|done, created $owner/$name")
	fi
	rulesets=$(gh api "repos/$owner/$name/rulesets" --paginate --jq '.[] | [.target, .name] | @tsv') ||
		die "Unable to list the rulesets of $owner/$name."
	if [[ $'\n'$rulesets == *$'\n'branch$'\t'* ]]; then
		branch_ruleset=1
	fi
	remote_info=$(git ls-remote --heads origin "refs/heads/$base") ||
		die "Unable to query origin/$base."
	if [[ -n $remote_info ]]; then
		git fetch --quiet origin "+refs/heads/$base:refs/remotes/origin/$base" ||
			die "Unable to fetch origin/$base."
		have_base=1
	fi

	# 4. Files: the defaults with their placeholders filled, then the release workflow. Existing files are
	# kept, and --force replaces those that differ.
	year=$(date +%Y)
	for rel in ${default_files[@]+"${default_files[@]}"}; do
		fill_placeholders "$dir/files/$rel" "$owner" "$name" "$year"
	done
	mkdir -p "$dir/files/.github/workflows"
	printf '%s\n' "$(release_workflow_template "$base")" >"$dir/files/.github/workflows/$RELEASE_WORKFLOW"
	default_files+=(".github/workflows/$RELEASE_WORKFLOW")
	for rel in "${default_files[@]}"; do
		if [[ -L $rel ]] || [[ -e $rel && ! -f $rel ]]; then
			kept+=("$rel")
			plan+=("kept     $rel (not a regular file)")
		elif [[ ! -e $rel ]]; then
			to_write+=("$rel")
			plan+=("new      $rel")
		elif [[ $(git hash-object --no-filters -- "$rel") == "$(git hash-object --no-filters -- "$dir/files/$rel")" ]]; then
			plan+=("same     $rel")
		elif ((force)); then
			to_write+=("$rel")
			plan+=("replace  $rel")
		else
			kept+=("$rel")
			plan+=("kept     $rel (yours differs; --force replaces it)")
		fi
	done
	# A push needs every commit on origin's base branch; that is checked before any file is written.
	if ((${#to_write[@]} > 0 && branch_ruleset == 0 && have_base == 1)); then
		if ! git rev-parse --quiet --verify HEAD >/dev/null ||
			[[ -n $(git rev-list -1 "HEAD..refs/remotes/origin/$base") ]]; then
			die "origin/$base has commits that $base lacks. Pull them first ('git pull origin $base'), then run init again."
		fi
	fi
	echo '==> Files:'
	printf '    %s\n' "${plan[@]}"
	for ((i = 0; i < ${#to_write[@]}; i++)); do
		rel=${to_write[i]}
		[[ $rel != */* ]] || mkdir -p -- "${rel%/*}"
		cp -- "$dir/files/$rel" "$rel"
	done
	if ((${#to_write[@]})); then
		echo "OK: Wrote ${#to_write[@]} file(s)."
		list="done, wrote ${#to_write[@]}"
	else
		list='already done, every file is there'
	fi
	((${#kept[@]} == 0)) || list+="; kept ${kept[*]}"
	summary+=("Files|$list")

	# 5. Commit exactly the files written above and push the base branch, unless a branch ruleset would
	# require a pull request for that push.
	push_line=''
	if ((${#to_write[@]} > 0 && branch_ruleset == 1)); then
		echo "==> $owner/$name has a branch ruleset, so init does not push to $base."
		echo '    The new files are written and uncommitted. Bring them in through a pull request.'
		push_line='skipped, a branch ruleset exists: bring the new files in through a pull request'
	elif ((${#to_write[@]} > 0)); then
		echo "==> A push to $owner/$name $base would publish:"
		echo "    (new)    chore: add repository defaults, with the ${#to_write[@]} new file(s) above"
		if git rev-parse --quiet --verify HEAD >/dev/null; then
			if ((have_base)); then
				git log --format='    %h  %s' "refs/remotes/origin/$base..HEAD"
			else
				git log --format='    %h  %s' HEAD
			fi
		fi
		if confirm "Commit and push these to $owner/$name $base?"; then
			git add -- "${to_write[@]}" ||
				die 'Unable to stage the new files; they are written and uncommitted.'
			# The paths limit the commit to these files, whatever else is staged.
			git commit -q -m 'chore: add repository defaults' -- "${to_write[@]}" ||
				die 'Commit failed; the new files are written and uncommitted.'
			# start-dev pulls the base branch, so a new one tracks origin.
			git config --get "branch.$base.remote" >/dev/null || push_args=(-u)
			git push --no-follow-tags ${push_args[@]+"${push_args[@]}"} origin "$base" ||
				die "Push failed; the commit stays on the local $base. Push it, then run init again."
			have_base=1
			echo "OK: Pushed the defaults to $owner/$name $base."
			push_line='done'
		else
			push_line='declined, the new files are written and uncommitted'
		fi
	fi
	for rel in "${default_files[@]}"; do
		if ((have_base == 0)) || ! git cat-file -e "refs/remotes/origin/$base:$rel" 2>/dev/null; then
			pending+=("$rel")
		fi
	done
	# With no file written in this run, there is nothing to commit; say whether the files are on origin.
	if [[ -z $push_line ]]; then
		push_line='already done, no file written in this run'
		((${#pending[@]} == 0)) || push_line="skipped, no file written in this run; not on origin/$base yet: ${pending[*]}"
	fi
	summary+=("Push|$push_line")

	# 6. Settings: one call per file, in a fixed order. They are not read back, so every run sends them.
	for line in "${settings_calls[@]}"; do
		read -r file method path <<<"$line"
		[[ -e $dir/settings/$file ]] || continue
		if [[ $file == code-scanning-default-setup.json ]] && ((have_base == 0)); then
			codeql_held=1
			continue
		fi
		apply+=("$line")
		names+=("$file")
	done
	if ((${#apply[@]})); then
		echo "==> Settings for $owner/$name: ${names[*]}"
		if confirm 'Apply?'; then
			for ((i = 0; i < ${#apply[@]}; i++)); do
				read -r file method path <<<"${apply[i]}"
				api_args=("repos/$owner/$name$path" --method "$method" --silent)
				[[ $file != *.json ]] || api_args+=(--input "$dir/settings/$file")
				gh api "${api_args[@]}" ||
					stop_partway "$i" "Applying defaults/settings/$file to $owner/$name failed, so init stopped there. Fix the cause, then run init again." "${names[@]}"
			done
			echo "OK: Sent ${#apply[@]} setting(s). init does not compare them with the repository, so every run sends them again."
			parts+=("done, sent ${#apply[@]} (every run sends them again)")
		else
			parts+=('declined')
		fi
	fi
	if ((codeql_held)); then
		echo "==> Held back CodeQL default setup until $base is on GitHub, so it has code to analyse. Run init again after the push."
		parts+=("held back CodeQL default setup until $base is on GitHub")
	fi
	((${#parts[@]})) || parts+=('skipped, none in the defaults')
	summary+=("Settings|$(join_list "; " "${parts[@]}")")

	# 7. Rulesets, always last, created by name. A branch ruleset waits until the files are on the base
	# branch, or it would require a pull request for the push that brings them.
	parts=() names=()
	for ((i = 0; i < ${#ruleset_files[@]}; i++)); do
		if [[ $'\n'$rulesets$'\n' == *$'\t'"${ruleset_names[i]}"$'\n'* ]]; then
			kept_rulesets+=", ${ruleset_names[i]}"
		elif [[ ${ruleset_targets[i]} == branch ]] && ((${#pending[@]})); then
			held_rulesets+=", ${ruleset_names[i]}"
		else
			create+=("$i")
			names+=("${ruleset_names[i]}")
		fi
	done
	[[ -z $kept_rulesets ]] || echo "==> Kept ruleset ${kept_rulesets#, }: $owner/$name already has a ruleset by that name."
	if [[ -n $held_rulesets ]]; then
		echo "==> Held back ruleset ${held_rulesets#, }: these files are not on origin/$base yet: ${pending[*]}"
		echo '    Commit and push them, or merge them through a pull request, then run init again.'
		parts+=("held back ${held_rulesets#, } until the files are on $base")
	fi
	if ((${#create[@]})); then
		echo "==> Rulesets to create on $owner/$name: $(join_list ", " "${names[@]}")"
		if confirm 'Create?'; then
			for ((i = 0; i < ${#create[@]}; i++)); do
				file=${ruleset_files[${create[i]}]}
				gh api "repos/$owner/$name/rulesets" --method POST --input "$dir/$file" --silent ||
					stop_partway "$i" "Creating the ruleset ${names[i]} from defaults/$file on $owner/$name failed, so init stopped there. Fix the cause, then run init again." "${names[@]}"
			done
			echo "OK: Created ruleset $(join_list ", " "${names[@]}")."
			parts+=("done, created $(join_list ", " "${names[@]}")")
		else
			parts+=("declined $(join_list ", " "${names[@]}")")
		fi
	fi
	[[ -z $kept_rulesets ]] || parts+=("already done, kept ${kept_rulesets#, }")
	((${#parts[@]})) || parts+=('skipped, none in the defaults')
	summary+=("Rulesets|$(join_list "; " "${parts[@]}")")

	echo
	echo '==> Summary:'
	for line in "${summary[@]}"; do
		printf '    %-11s %s\n' "${line%%|*}:" "${line#*|}"
	done
}

usage() {
	cat <<'EOF'
Usage:
  gh release-flow init [--force]
  gh release-flow start-dev [version]
  gh release-flow open-pr
  gh release-flow merge
  gh release-flow setup-make
  gh release-flow upgrade
  gh release-flow version
  gh release-flow help
EOF
}

main() {
	local command=${1:-}
	[[ -z $command ]] || shift
	case $command in
	init)
		init_workflow "$@"
		;;
	start-dev)
		(($# <= 1)) || die 'start-dev accepts one version.'
		start_dev "${1:-}"
		;;
	open-pr)
		(($# == 0)) || die 'open-pr accepts no arguments.'
		open_pr
		;;
	merge | merge-release)
		(($# == 0)) || die 'merge accepts no arguments.'
		merge_release
		;;
	setup-make)
		(($# == 0)) || die 'setup-make accepts no arguments.'
		setup_make
		;;
	upgrade)
		(($# == 0)) || die 'upgrade accepts no arguments.'
		# exec: the upgrade rewrites this file, so bash must not keep reading it.
		# Make targets that setup-make wrote are refreshed by the upgraded version.
		if grep -Fqxs -- "$make_marker" "$HOME/.config/make/release-flow.mk"; then
			exec bash -c 'gh extension upgrade release-flow && gh release-flow setup-make'
		fi
		exec gh extension upgrade release-flow
		;;
	version | --version)
		(($# == 0)) || die 'version accepts no arguments.'
		echo "gh-release-flow $(tool_version)"
		;;
	-h | --help | help | '') usage ;;
	*)
		usage >&2
		exit 2
		;;
	esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	main "$@"
fi
