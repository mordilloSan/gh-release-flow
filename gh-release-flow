#!/usr/bin/env bash
set -euo pipefail

DEFAULT_BASE_BRANCH=${DEFAULT_BASE_BRANCH:-main}
RELEASE_WORKFLOW=${RELEASE_WORKFLOW:-release.yml}
REPO=${REPO:-}
CONFIRM=${CONFIRM:-1}
TOOL_VERSION=v1.4.0 # bump on each release; VERSION is the release being cut
PR=${PR:-}
[[ -z $REPO ]] || export GH_REPO=$REPO
export GH_PAGER=cat
version_re='^v[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9.-]+)?$'

die() {
	echo "ERROR: $*" >&2
	exit 1
}

tree_dirty() {
	! git diff --quiet || ! git diff --cached --quiet
}

require_clean() {
	[[ $(git rev-parse --is-inside-work-tree 2>/dev/null) == true ]] ||
		die 'Not inside a Git working tree.'
	if tree_dirty; then
		die 'Working tree not clean. Commit or stash changes first.'
	fi
}

require_gh() {
	command -v gh >/dev/null 2>&1 ||
		die 'GitHub CLI (gh) not found. Install it from https://cli.github.com/'
}

# Sets PUSH_REPO (host/owner/name) for a remote and points gh at it, unless REPO chose a repository.
use_push_repo() {
	local remote_url
	if ! remote_url=$(git remote get-url "$1") ||
		! PUSH_REPO=$(gh repo view "$remote_url" --json url --jq '.url | sub("^https?://"; "")'); then
		die "Unable to identify the GitHub repository behind remote '$1'."
	fi
	if [[ -z $REPO ]]; then
		export GH_REPO=$PUSH_REPO
		echo "==> Using GitHub repository $PUSH_REPO"
	fi
}

find_pr() {
	local state=$1 owner=$2
	gh pr list --base "$DEFAULT_BASE_BRANCH" --head "$BRANCH" \
		--state "$state" --json number,headRepositoryOwner \
		--jq "map(select(.headRepositoryOwner.login == \"$owner\")) | .[0].number // empty"
}

latest_tag() {
	git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' "origin/$DEFAULT_BASE_BRANCH" 2>/dev/null || true
}

read_version() {
	local candidate=${1:-${VERSION:-}} latest
	if [[ -z $candidate ]]; then
		latest=$(latest_tag)
		[[ -n $latest ]] && echo "==> Latest release: $latest" || echo '==> No release tag yet.'
		read -r -p 'Enter version (e.g. v1.2.3): ' candidate || true
	fi
	VERSION=${candidate/#V/v}
	[[ $VERSION =~ $version_re ]] ||
		die "VERSION must look like v1.2.3 or v1.2.3-rc.1 (got '$VERSION')"
	REL_BRANCH=dev/$VERSION
	git check-ref-format --branch "$REL_BRANCH" >/dev/null 2>&1 ||
		die "VERSION cannot form a valid Git branch (got '$VERSION')"
}

read_release_branch() {
	BRANCH=$(git rev-parse --abbrev-ref HEAD)
	[[ $BRANCH =~ ^dev/${version_re#^} ]] ||
		die "Current branch '$BRANCH' is not a dev/v* release branch."
	VERSION=${BRANCH#dev/}
}

previous_tag() {
	git describe --tags --abbrev=0 --match 'v[0-9]*.[0-9]*.[0-9]*' --exclude "$1" HEAD 2>/dev/null || true
}

generate_changelog() {
	local version=$1 previous=$2 commit_range=$3 repo=$4
	local features='' fixes='' docs='' style='' refactor='' perf=''
	local tests='' build='' ci='' chore='' other=''
	local message hash author entry contributors=''
	local -a log_args=(--no-show-signature --reverse --no-merges --pretty=format:'%s%x00%h%x00%aN%x00')
	[[ -n $commit_range ]] && log_args+=("$commit_range")

	while IFS= read -r -d '' message &&
		IFS= read -r -d '' hash &&
		IFS= read -r -d '' author; do
		message=${message#$'\n'}
		[[ -n $message ]] || continue
		[[ $author != 'github-actions[bot]' ]] || continue
		[[ ! $message =~ ^[Cc]hangelog$ ]] || continue

		contributors+="* $author"$'\n'
		entry="* $message ([${hash:0:7}](https://github.com/$repo/commit/$hash)) by $author"
		if [[ $message =~ ^feat(\(.*\))?!?: ]]; then
			features+="$entry"$'\n'
		elif [[ $message =~ ^fix(\(.*\))?!?: ]]; then
			fixes+="$entry"$'\n'
		elif [[ $message =~ ^docs(\(.*\))?!?: ]]; then
			docs+="$entry"$'\n'
		elif [[ $message =~ ^style(\(.*\))?!?: ]]; then
			style+="$entry"$'\n'
		elif [[ $message =~ ^refactor(\(.*\))?!?: ]]; then
			refactor+="$entry"$'\n'
		elif [[ $message =~ ^perf(\(.*\))?!?: ]]; then
			perf+="$entry"$'\n'
		elif [[ $message =~ ^test(\(.*\))?!?: ]]; then
			tests+="$entry"$'\n'
		elif [[ $message =~ ^build(\(.*\))?!?: ]]; then
			build+="$entry"$'\n'
		elif [[ $message =~ ^ci(\(.*\))?!?: ]]; then
			ci+="$entry"$'\n'
		elif [[ $message =~ ^chore(\(.*\))?!?: ]]; then
			chore+="$entry"$'\n'
		else
			other+="$entry"$'\n'
		fi
	done < <(git log "${log_args[@]}")

	[[ -z $features ]] || printf '###  Features\n\n%s\n' "$features"
	[[ -z $fixes ]] || printf '###  Bug Fixes\n\n%s\n' "$fixes"
	[[ -z $perf ]] || printf '###  Performance\n\n%s\n' "$perf"
	[[ -z $refactor ]] || printf '###  Refactoring\n\n%s\n' "$refactor"
	[[ -z $docs ]] || printf '###  Documentation\n\n%s\n' "$docs"
	[[ -z $style ]] || printf '###  Style\n\n%s\n' "$style"
	[[ -z $tests ]] || printf '###  Tests\n\n%s\n' "$tests"
	[[ -z $build ]] || printf '###  Build\n\n%s\n' "$build"
	[[ -z $ci ]] || printf '###  CI/CD\n\n%s\n' "$ci"
	[[ -z $chore ]] || printf '###  Chores\n\n%s\n' "$chore"
	[[ -z $other ]] || printf '###  Other Changes\n\n%s\n' "$other"

	printf '###  Contributors\n\n'
	printf '%s' "$contributors" | sort -u
	if [[ -n $previous ]]; then
		printf '\n\n**Full Changelog**: https://github.com/%s/compare/%s...%s\n' \
			"$repo" "$previous" "$version"
	else
		printf '\n\n**Full Changelog**: https://github.com/%s/releases/tag/%s\n' \
			"$repo" "$version"
	fi
}

generate_pr_body() {
	local repo_name=${REPO:-${GITHUB_REPOSITORY:-${PUSH_REPO#*/}}} previous commit_range
	previous=$(previous_tag "$VERSION")
	commit_range=''
	[[ -z $previous ]] || commit_range=$previous..HEAD
	PR_BODY_FILE=$(mktemp)
	{
		echo "## $VERSION — $(date -u +%Y-%m-%d)"
		echo
		generate_changelog "$VERSION" "$previous" "$commit_range" "$repo_name"
	} >"$PR_BODY_FILE"
}

start_dev() {
	local moving=0 answer
	# Changes on the protected base branch may move to the release branch; the user is asked below.
	if [[ $(git rev-parse --abbrev-ref HEAD 2>/dev/null) == "$DEFAULT_BASE_BRANCH" ]] && tree_dirty; then
		moving=1
	else
		require_clean
	fi
	git fetch origin
	read_version "${1:-}"
	if git show-ref --verify --quiet refs/heads/dev || git show-ref --verify --quiet refs/remotes/origin/dev; then
		die "A branch named 'dev' exists, so Git cannot create $REL_BRANCH. Rename or delete 'dev' first."
	fi
	if git ls-remote --exit-code --tags origin "refs/tags/$VERSION" >/dev/null; then
		die "Tag $VERSION already exists on origin. Pick a new version."
	fi
	if ((moving == 1)); then
		echo "==> Uncommitted changes on $DEFAULT_BASE_BRANCH:"
		git status --short --untracked-files=no
		printf '    Move them to %s? [y/N] ' "$REL_BRANCH"
		read -r answer || answer=''
		[[ $answer =~ ^[yY]([eE][sS])?$ ]] ||
			die 'Working tree not clean. Commit or stash changes first.'
	fi
	# Git carries uncommitted changes through these steps, or refuses and leaves them untouched.
	git checkout "$DEFAULT_BASE_BRANCH"
	git pull --ff-only
	if git show-ref --verify --quiet "refs/heads/$REL_BRANCH"; then
		echo "==> Branch $REL_BRANCH already exists, checking it out…"
		git checkout "$REL_BRANCH"
	elif git show-ref --verify --quiet "refs/remotes/origin/$REL_BRANCH"; then
		echo "==> Branch $REL_BRANCH exists on origin, checking it out…"
		git checkout --track "origin/$REL_BRANCH"
	else
		echo "==> Creating branch $REL_BRANCH from $DEFAULT_BASE_BRANCH…"
		git checkout -b "$REL_BRANCH" "$DEFAULT_BASE_BRANCH"
		git push --no-follow-tags -u origin "$REL_BRANCH"
	fi
	echo "OK: Ready on branch $REL_BRANCH"
	((moving == 0)) || echo "    Your uncommitted changes came along. Commit them, then run 'gh release-flow open-pr'."
}

open_pr() {
	local push_remote push_owner remote_ref remote_info behind ahead
	local prnum check_output check_status start_time total_time pr_url i
	local open_pr_status=0
	require_clean
	require_gh
	read_release_branch
	trap 'rm -f "${PR_BODY_FILE:-}"' EXIT

	push_remote=$(git config --get "branch.$BRANCH.remote" 2>/dev/null || echo origin)
	use_push_repo "$push_remote"
	IFS=/ read -r _ push_owner _ <<<"$PUSH_REPO"
	remote_ref=refs/remotes/$push_remote/$BRANCH
	if ! remote_info=$(git ls-remote --heads "$push_remote" "refs/heads/$BRANCH"); then
		die "Unable to query $push_remote/$BRANCH; refusing to use a stale tracking ref."
	fi
	if [[ -z $remote_info ]]; then
		echo "==> $push_remote/$BRANCH does not exist yet - publishing…"
		git push --no-follow-tags -u "$push_remote" "HEAD:refs/heads/$BRANCH"
	else
		git fetch --quiet "$push_remote" "+refs/heads/$BRANCH:$remote_ref" ||
			die "Unable to fetch $push_remote/$BRANCH; refusing to use a stale tracking ref."
		behind=$(git rev-list --count "HEAD..$remote_ref")
		ahead=$(git rev-list --count "$remote_ref..HEAD")
		if ((behind > 0 && ahead > 0)); then
			die "$BRANCH has diverged from $push_remote/$BRANCH ($behind behind, $ahead ahead). Reconcile deliberately, then re-run."
		fi
		((behind == 0)) || die "$BRANCH is $behind commit(s) behind $push_remote/$BRANCH. Reconcile first, then re-run."
		if ((ahead > 0)); then
			echo "==> Publishing $ahead local commit(s) to $push_remote/$BRANCH…"
			git push --no-follow-tags "$push_remote" "HEAD:refs/heads/$BRANCH"
		else
			echo "==> $BRANCH already in sync with $push_remote/$BRANCH - nothing to push."
		fi
	fi

	prnum=$(find_pr open "$push_owner") ||
		die "Unable to query open PRs for $BRANCH."
	generate_pr_body
	if [[ -n $prnum ]]; then
		echo "==> An open PR (#$prnum) from $BRANCH -> $DEFAULT_BASE_BRANCH already exists."
		echo '==> Refreshing PR body with the latest changelog…'
		gh pr edit "$prnum" --body-file "$PR_BODY_FILE"
		echo 'OK: PR body updated.'
	else
		echo "==> Opening PR: $BRANCH -> $DEFAULT_BASE_BRANCH…"
		gh pr create --base "$DEFAULT_BASE_BRANCH" --head "$BRANCH" \
			--title "Release $VERSION" --body-file "$PR_BODY_FILE"
		prnum=$(find_pr open "$push_owner")
	fi

	echo
	echo '==> Waiting for CI checks to register...'
	sleep 3
	for i in 1 2 3 4 5; do
		check_output=$(gh pr checks "$prnum" 2>&1 || true)
		grep -q 'no checks reported' <<<"$check_output" || break
		((i == 5)) || {
			echo "==> Retrying in 2s... (attempt $i/5)"
			sleep 2
		}
	done
	if grep -q 'no checks reported' <<<"$check_output"; then
		echo 'WARN: No CI checks detected after 11s. Skipping check wait.'
		echo '    Checks might start later - monitor the PR manually.'
	else
		echo "==> Waiting for checks to complete on PR #$prnum…"
		echo "    (Ctrl+C stops watching; re-run 'gh release-flow open-pr' to resume)"
		echo
		start_time=$(date +%s)
		check_status=0
		gh pr checks "$prnum" --watch --interval 5 || check_status=$?
		total_time=$(($(date +%s) - start_time))
		echo
		if ((check_status != 0)); then
			check_status=0
			gh pr checks "$prnum" >/dev/null 2>&1 || check_status=$?
		fi
		if ((check_status == 0)); then
			printf 'OK: All checks passed! (took %02d:%02d)\n' $((total_time / 60)) $((total_time % 60))
		elif ((check_status == 8)); then
			echo 'WARN: Check monitoring stopped while checks are still pending.'
			echo "    Re-run 'gh release-flow open-pr' to resume watching."
			open_pr_status=1
		else
			gh pr checks "$prnum" || true
			echo
			echo "ERROR: Checks failed on PR #$prnum."
			open_pr_status=1
		fi
	fi

	echo
	pr_url=$(gh pr view "$prnum" --json url --jq '.url' 2>/dev/null || true)
	[[ -z $pr_url ]] && echo "==> View PR #$prnum with: gh pr view $prnum" || echo "==> PR #$prnum: $pr_url"
	return "$open_pr_status"
}

merge_release() {
	local push_remote push_owner prnum='' pr_state='' release_head remote_info remote_head
	local pr_info pr_base pr_head pr_oid pr_owner pr_cross previous commit_count commit_scope answer merged_at
	local check_output check_status=0 workflow_tsv='' run_id status conclusion i
	local workflow_success=0 start_time total_time final_conclusion
	local cleanup_info release_url resume_hint
	require_clean
	require_gh
	gh run list --help 2>&1 | grep -q -- '--commit' ||
		die 'Update gh to 2.40 or newer: this flow needs gh run list --commit.'
	read_release_branch
	push_remote=$(git config --get "branch.$BRANCH.remote" 2>/dev/null || echo origin)
	use_push_repo "$push_remote"
	IFS=/ read -r _ push_owner _ <<<"$PUSH_REPO"

	if [[ -n $PR ]]; then
		prnum=$PR
		pr_state=$(gh pr view "$prnum" --json state --jq '.state') ||
			die "Unable to query PR #$prnum."
	else
		prnum=$(find_pr open "$push_owner") ||
			die "Unable to query open PRs for $BRANCH."
		pr_state=OPEN
		if [[ -z $prnum ]]; then
			prnum=$(find_pr merged "$push_owner") ||
				die "Unable to query merged PRs for $BRANCH."
			pr_state=MERGED
		fi
	fi
	[[ -n $prnum ]] ||
		die "No open or merged PR from $BRANCH to $DEFAULT_BASE_BRANCH."
	[[ $pr_state == OPEN || $pr_state == MERGED ]] ||
		die "PR #$prnum state is '$pr_state' (expected OPEN or MERGED)."
	pr_info=$(gh pr view "$prnum" \
		--json baseRefName,headRefName,headRefOid,headRepositoryOwner,isCrossRepository \
		--jq '[.baseRefName, .headRefName, .headRefOid, .headRepositoryOwner.login, .isCrossRepository] | @tsv')
	IFS=$'\t' read -r pr_base pr_head pr_oid pr_owner pr_cross <<<"$pr_info"
	[[ $pr_base == "$DEFAULT_BASE_BRANCH" && $pr_head == "$BRANCH" && -n $pr_oid && $pr_owner == "$push_owner" ]] ||
		die "PR #$prnum is not a $BRANCH -> $DEFAULT_BASE_BRANCH release PR."
	# A fork PR's release run gets a read-only token, so it can never publish.
	[[ $pr_cross == false ]] ||
		die "PR #$prnum comes from a fork. Push $BRANCH to the repository that receives the PR."

	if [[ $pr_state == MERGED ]]; then
		echo "==> PR #$prnum from $BRANCH is already merged - resuming release watch and cleanup."
		release_head=$pr_oid
	else
		echo "==> Checking status of PR #$prnum…"
		remote_info=$(git ls-remote --heads "$push_remote" "refs/heads/$BRANCH") ||
			die "Unable to query $push_remote/$BRANCH; refusing to merge an unsynchronized PR."
		[[ -n $remote_info ]] || die "$push_remote/$BRANCH does not exist; refusing to merge."
		release_head=$(git rev-parse HEAD)
		remote_head=${remote_info%%$'\t'*}
		[[ $release_head == "$remote_head" ]] ||
			die "Local HEAD is not synchronized with $push_remote/$BRANCH. Push or reconcile, then re-run."
		[[ $pr_oid == "$release_head" ]] ||
			die "PR #$prnum is not synchronized with local $BRANCH. Push or reconcile, then re-run."

		# Read checks only after the PR head matches HEAD, so they belong to the commit being merged.
		check_output=$(gh pr checks "$prnum" 2>&1) || check_status=$?
		if [[ $check_output == *'no checks reported'* ]]; then
			die "No CI checks are reported for PR #$prnum. Wait for checks, then re-run." \
				"A skip-ci marker such as [skip ci] in the last commit message blocks checks; push a new commit to clear it."
		fi
		if ((check_status != 0)); then
			printf '%s\n' "$check_output" >&2
			((check_status != 8)) ||
				die "Checks are still running on PR #$prnum. Wait for them to finish, then re-run."
			die "Checks have not passed on PR #$prnum. Run 'gh release-flow open-pr' to watch them."
		fi
		echo 'OK: All checks passed.'

		previous=$(previous_tag "$VERSION")
		if [[ -n $previous ]]; then
			commit_count=$(git rev-list --count "$previous..HEAD" 2>/dev/null || echo '?')
			commit_scope="since $previous"
		else
			commit_count=$(git rev-list --count HEAD)
			commit_scope=total
		fi
		echo
		echo "==> Ready to merge release $VERSION:"
		echo "    PR:      #$prnum ($BRANCH -> $DEFAULT_BASE_BRANCH)"
		echo "    Commits: $commit_count $commit_scope"
		echo "    Head:    $release_head"
		if [[ $CONFIRM == 0 ]]; then
			echo '==> CONFIRM=0 set - skipping confirmation prompt.'
		else
			printf '    Merge PR #%s into %s? [y/N] ' "$prnum" "$DEFAULT_BASE_BRANCH"
			read -r answer || answer=''
			[[ $answer =~ ^[yY]([eE][sS])?$ ]] || die 'Merge aborted.'
		fi
		echo
		echo "==> Merging PR #$prnum…"
		gh pr merge "$prnum" --merge --match-head-commit "$release_head" ||
			die 'Merge failed. Branch not deleted.'
	fi
	merged_at=$(gh pr view "$prnum" --json mergedAt --jq '.mergedAt // empty') ||
		die "Unable to determine when PR #$prnum was merged."
	[[ -n $merged_at ]] ||
		die "PR #$prnum is not merged yet; a merge queue may still be processing it. Re-run 'gh release-flow merge' after GitHub merges it."

	echo "==> Tag to be released: $VERSION"
	echo
	echo '==> Checking for release workflow...'
	sleep 2
	for ((i = 1; i <= 10; i++)); do
		workflow_tsv=$(gh run list --workflow="$RELEASE_WORKFLOW" \
			--event pull_request --commit "$release_head" --created ">=$merged_at" --limit 1 \
			--json databaseId,status,conclusion \
			--jq '.[0] // empty | [(.databaseId | tostring), .status, (.conclusion // "n/a")] | @tsv')
		[[ -z $workflow_tsv ]] || break
		echo "==> Waiting for workflow to start... (attempt $i/10)"
		sleep 2
	done
	[[ -n $workflow_tsv ]] ||
		die "Could not identify the $RELEASE_WORKFLOW run for $VERSION. Re-run after it starts."
	IFS=$'\t' read -r run_id status conclusion <<<"$workflow_tsv"
	echo '==> Release workflow found'
	echo "    Run ID: #$run_id"
	echo "    Status: $status"

	if [[ $status != completed ]]; then
		echo
		echo "==> Watching release workflow #$run_id..."
		echo "    (Ctrl+C stops watching; re-run 'gh release-flow merge' to resume)"
		echo
		start_time=$(date +%s)
		if gh run watch "$run_id" --exit-status; then
			total_time=$(($(date +%s) - start_time))
			printf 'OK: Release workflow completed! (took %02d:%02d)\n' $((total_time / 60)) $((total_time % 60))
			workflow_success=1
		else
			final_conclusion=$(gh run view "$run_id" \
				--json conclusion --jq '.conclusion // ""' 2>/dev/null || true)
			[[ -n $final_conclusion ]] ||
				die "Could not read the result of run #$run_id. Re-run 'gh release-flow merge' to resume."
			if [[ $final_conclusion == success ]]; then
				workflow_success=1
			else
				echo "ERROR: Release workflow failed (conclusion: $final_conclusion)"
				gh run view "$run_id" || true
			fi
		fi
	else
		echo "==> Workflow already completed: $conclusion"
		[[ $conclusion == success ]] && workflow_success=1
		gh run view "$run_id" || true
	fi

	echo
	if ((workflow_success == 1)); then
		echo "==> Cleaning up: deleting branch $BRANCH..."
		git checkout "$DEFAULT_BASE_BRANCH" ||
			die "Unable to check out $DEFAULT_BASE_BRANCH. If another worktree has it checked out, switch that worktree to another branch, then re-run 'gh release-flow merge'."
		resume_hint="Run 'git checkout $BRANCH', then re-run 'gh release-flow merge'."
		git pull --ff-only || die "Unable to update $DEFAULT_BASE_BRANCH. $resume_hint"
		git merge-base --is-ancestor "$release_head" "$DEFAULT_BASE_BRANCH" ||
			die "$BRANCH is not contained in $DEFAULT_BASE_BRANCH; leaving branch refs intact. $resume_hint"
		cleanup_info=$(git ls-remote --heads "$push_remote" "refs/heads/$BRANCH") ||
			die "Unable to query $push_remote/$BRANCH for safe cleanup. $resume_hint"
		if [[ -n $cleanup_info && ${cleanup_info%%$'\t'*} != "$release_head" ]]; then
			die "$push_remote/$BRANCH advanced after merge; leaving branch refs intact. Run 'git checkout $BRANCH' to review the new commits."
		fi
		if [[ -n $cleanup_info ]]; then
			git push --force-with-lease="refs/heads/$BRANCH:$release_head" \
				"$push_remote" ":refs/heads/$BRANCH" ||
				die "Unable to delete remote branch; local branch kept for retry. $resume_hint"
		fi
		# A stale tracking ref would let 'git branch -d' approve commits that are not in the base branch.
		git update-ref -d "refs/remotes/$push_remote/$BRANCH"
		git branch -d "$BRANCH" ||
			die "Unable to delete local branch $BRANCH. Review its commits with 'git log $DEFAULT_BASE_BRANCH..$BRANCH'."
		echo 'OK: Branch cleanup complete'
		release_url=$(gh release view "$VERSION" --json url --jq '.url' 2>/dev/null || true)
		echo
		[[ -z $release_url ]] && echo "OK: Release $VERSION complete (no GitHub Release found for $VERSION)." ||
			echo "OK: Release $VERSION published: $release_url"
	else
		die "Workflow did not succeed. Keeping branch $BRANCH for debugging."
	fi
}

usage() {
	cat <<'EOF'
Usage:
  gh release-flow start-dev [version]
  gh release-flow open-pr
  gh release-flow merge
  gh release-flow upgrade
  gh release-flow version
  gh release-flow help
EOF
}

main() {
	local command=${1:-}
	[[ -z $command ]] || shift
	case $command in
	start-dev)
		(($# <= 1)) || die 'start-dev accepts one version.'
		start_dev "${1:-}"
		;;
	open-pr)
		(($# == 0)) || die 'open-pr accepts no arguments.'
		open_pr
		;;
	merge | merge-release)
		(($# == 0)) || die 'merge accepts no arguments.'
		merge_release
		;;
	upgrade)
		(($# == 0)) || die 'upgrade accepts no arguments.'
		# exec: the upgrade rewrites this file, so bash must not keep reading it.
		exec gh extension upgrade release-flow
		;;
	version | --version)
		(($# == 0)) || die 'version accepts no arguments.'
		echo "gh-release-flow $TOOL_VERSION"
		;;
	-h | --help | help | '') usage ;;
	*)
		usage >&2
		exit 2
		;;
	esac
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
	main "$@"
fi
